---
// Precifarm wordmark. Vector recreation of the brand logo: a navy solar-panel
// mark with an orange flame accent, the PRECIFARM wordmark, and an optional
// "Renewable Energy" italic tagline.
//
// Variants:
//  - variant="dark" (default): navy mark + dark wordmark, for white/light bgs
//  - variant="white": white mark + white wordmark, for navy-dark bgs
// The orange flame stays the same in both — it is the constant accent.

export interface Props {
  variant?: 'dark' | 'white';
  size?: 'sm' | 'md' | 'lg';
  showTagline?: boolean;
}

const { variant = 'dark', size = 'md', showTagline = false } = Astro.props;

const isWhite = variant === 'white';
const panelFill = isWhite ? '#FFFFFF' : '#1F4E5F';
const panelDeep = isWhite ? '#9CA3AF' : '#0F2832';
const panelHighlight = isWhite ? '#F7F7F4' : '#2A6878';
const wordmarkFill = isWhite ? '#FFFFFF' : '#0F2832';
const taglineFill = isWhite ? 'rgba(255,255,255,0.85)' : '#1F4E5F';
const flameOrange = '#E37E32';
const flameYellow = '#F5C518';

const sizeClass = {
  sm: 'h-9 md:h-10',
  md: 'h-11 md:h-12',
  lg: 'h-16 md:h-20',
}[size];

const viewBoxH = showTagline ? 190 : 150;
---
<svg
  viewBox={`0 0 360 ${viewBoxH}`}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={showTagline ? 'Precifarm — Renewable Energy' : 'Precifarm'}
  class={`w-auto ${sizeClass}`}
  preserveAspectRatio="xMidYMid meet"
>
  <!-- Solar panel mark in slight perspective -->
  <g>
    <!-- Main panel surface -->
    <path
      d="M75,10 L285,10 L272,55 L88,55 Z"
      fill={panelFill}
      stroke={panelDeep}
      stroke-width="1.5"
      stroke-linejoin="round"
    />
    <!-- Vertical cell dividers (4 lines for 5 columns) -->
    <line x1="117" y1="10" x2="109" y2="55" stroke={panelDeep} stroke-width="0.9" opacity="0.55"/>
    <line x1="159" y1="10" x2="148" y2="55" stroke={panelDeep} stroke-width="0.9" opacity="0.55"/>
    <line x1="201" y1="10" x2="187" y2="55" stroke={panelDeep} stroke-width="0.9" opacity="0.55"/>
    <line x1="243" y1="10" x2="226" y2="55" stroke={panelDeep} stroke-width="0.9" opacity="0.55"/>
    <!-- Horizontal cell dividers (2 lines for 3 rows) -->
    <line x1="82" y1="25" x2="278" y2="25" stroke={panelDeep} stroke-width="0.9" opacity="0.55"/>
    <line x1="85" y1="40" x2="275" y2="40" stroke={panelDeep} stroke-width="0.9" opacity="0.55"/>
    <!-- Subtle top highlight -->
    <path
      d="M75,10 L285,10 L283,14 L77,14 Z"
      fill={panelHighlight}
      opacity="0.5"
    />
  </g>

  <!-- Orange flame accent, top-right of panel -->
  <g>
    <path
      d="M268,12 C280,-2 296,-4 300,8 C302,18 294,26 276,26 C268,24 262,18 268,12 Z"
      fill={flameOrange}
    />
    <path
      d="M278,9 C285,3 292,5 290,12 C288,19 277,20 278,9 Z"
      fill={flameYellow}
      opacity="0.85"
    />
  </g>

  <!-- PRECIFARM wordmark, dominant -->
  <text
    x="180"
    y="120"
    text-anchor="middle"
    font-family="Helvetica, Arial, sans-serif"
    font-weight="900"
    font-size="62"
    fill={wordmarkFill}
    letter-spacing="-2"
  >PRECIFARM</text>

  {showTagline && (
    <text
      x="180"
      y="172"
      text-anchor="middle"
      font-family="Helvetica, Arial, sans-serif"
      font-style="italic"
      font-weight="400"
      font-size="22"
      fill={taglineFill}
      letter-spacing="1.5"
    >Renewable Energy</text>
  )}
</svg>
