---
// Precifarm wordmark.
//  - variant="dark" (default): renders the supplied brand PNG (navy panel,
//    orange flame, dark wordmark, italic tagline). Use on white/light bgs.
//  - variant="white": renders a vector recreation in white, for navy-dark
//    backgrounds (e.g. the footer). The brand PNG has dark fills that
//    would not read on a dark background; this variant covers that case
//    until a dedicated white master file is provided.

export interface Props {
  variant?: 'dark' | 'white';
  size?: 'sm' | 'md' | 'lg';
  showTagline?: boolean;
}

const { variant = 'dark', size = 'md', showTagline = false } = Astro.props;

const sizeClass = {
  sm: 'h-9 md:h-10',
  md: 'h-10 md:h-12',
  lg: 'h-14 md:h-16',
}[size];

const isWhite = variant === 'white';
---
{!isWhite ? (
  <img
    src="/images/brand/precifarm-logo.png"
    alt={showTagline ? 'Precifarm — Renewable Energy' : 'Precifarm'}
    width="600"
    height="220"
    decoding="async"
    class={`w-auto ${sizeClass}`}
  />
) : (
  <svg
    viewBox={`0 0 320 ${showTagline ? 145 : 105}`}
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={showTagline ? 'Precifarm — Renewable Energy' : 'Precifarm'}
    class={`w-auto ${sizeClass}`}
    preserveAspectRatio="xMidYMid meet"
  >
    <g>
      <path
        d="M70,5 L250,5 L240,42 L80,42 Z"
        fill="#FFFFFF"
        stroke="#9CA3AF"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <line x1="106" y1="5" x2="100" y2="42" stroke="#9CA3AF" stroke-width="0.9" opacity="0.55"/>
      <line x1="142" y1="5" x2="134" y2="42" stroke="#9CA3AF" stroke-width="0.9" opacity="0.55"/>
      <line x1="178" y1="5" x2="168" y2="42" stroke="#9CA3AF" stroke-width="0.9" opacity="0.55"/>
      <line x1="214" y1="5" x2="202" y2="42" stroke="#9CA3AF" stroke-width="0.9" opacity="0.55"/>
      <line x1="76" y1="17" x2="244" y2="17" stroke="#9CA3AF" stroke-width="0.9" opacity="0.55"/>
      <line x1="78" y1="30" x2="242" y2="30" stroke="#9CA3AF" stroke-width="0.9" opacity="0.55"/>
    </g>
    <g>
      <path d="M234,8 C246,-4 260,-6 264,4 C266,14 258,22 242,22 C234,20 228,14 234,8 Z" fill="#E37E32"/>
      <path d="M244,6 C251,1 258,3 256,9 C254,16 244,17 244,6 Z" fill="#F5C518" opacity="0.85"/>
    </g>
    <text
      x="160"
      y="88"
      text-anchor="middle"
      font-family="'Arial Black', 'Helvetica Neue', Helvetica, Arial, sans-serif"
      font-weight="900"
      font-size="44"
      fill="#FFFFFF"
      stroke="#FFFFFF"
      stroke-width="0.6"
      paint-order="stroke fill"
      letter-spacing="-0.5"
    >PRECIFARM</text>
    {showTagline && (
      <text
        x="160"
        y="128"
        text-anchor="middle"
        font-family="'Helvetica Neue', Helvetica, Arial, sans-serif"
        font-style="italic"
        font-weight="500"
        font-size="18"
        fill="rgba(255,255,255,0.85)"
        letter-spacing="1.5"
      >Renewable Energy</text>
    )}
  </svg>
)}
