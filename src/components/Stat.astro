---
export interface Props {
  value: string;
  label: string;
  variant?: 'default' | 'dark';
}

const { value, label, variant = 'default' } = Astro.props;
const valueColor = variant === 'dark' ? 'text-white' : 'text-navy-dark';
const labelColor = variant === 'dark' ? 'text-white/70' : 'text-text-muted';
---
<div>
  <p class={`text-3xl md:text-4xl font-bold tracking-tight ${valueColor}`}>{value}</p>
  <p class={`mt-2 text-sm font-medium ${labelColor}`}>{label}</p>
</div>
