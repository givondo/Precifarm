---
// Hero photograph slot. Used in the homepage hero next to the headline.
// To swap photos, drop a 1600-wide JPG into /public/images/hero/ and update the src below.
---
<div class="relative overflow-hidden rounded-card shadow-xl ring-1 ring-black/5">
  <img
    src="/images/hero/hero-modular-storage.jpg"
    alt="A modular wall-mounted lithium battery stack of four stacked modules with an adjacent rooftop solar PV array on a clean residential exterior, illustrating Precifarm's modular solar PV and storage architecture."
    width="1120"
    height="959"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="w-full h-full object-cover aspect-[4/3]"
  />
  <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-navy-dark/30 to-transparent pointer-events-none"></div>
</div>
