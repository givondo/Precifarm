---
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Products',
    links: [
      { href: '/products/', label: 'All packages' },
      { href: '/products/starter/', label: 'Starter' },
      { href: '/products/family/', label: 'Family' },
      { href: '/products/commercial/', label: 'Commercial' },
      { href: '/products/commercial-plus/', label: 'Commercial Plus' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { href: '/about/', label: 'About' },
      { href: '/how-we-work/', label: 'How we work' },
      { href: '/cities/', label: 'Cities' },
      { href: '/blog/', label: 'Blog' },
      { href: '/contact/', label: 'Contact' },
    ],
  },
  {
    heading: 'Support',
    links: [
      { href: '/financing/', label: 'Financing' },
      { href: '/contact/', label: 'Get a quote' },
      { href: '/privacy/', label: 'Privacy' },
      { href: '/terms/', label: 'Terms' },
    ],
  },
];
---
<footer class="bg-paper text-text-mid border-t border-hairline">
  <div class="container-page py-12 md:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">
      {columns.map((col) => (
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-navy-dark mb-4">{col.heading}</h2>
          <ul class="space-y-2">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-text-mid hover:text-navy transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-navy-dark mb-4">Contact</h2>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="mailto:sales@precifarm.com" class="text-text-mid hover:text-navy transition-colors">
              sales@precifarm.com
            </a>
          </li>
          <li>
            <a href="tel:+254794702768" class="text-text-mid hover:text-navy transition-colors">
              +254 794 702 768
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/254794702768"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 text-text-mid hover:text-green transition-colors"
            >
              <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp
            </a>
          </li>
          <li class="text-text-muted mt-3">
            Anywhere in Kenya.<br />
            HQ in Nairobi.
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-hairline flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <Logo variant="dark" size="lg" showTagline={true} />
        <p class="mt-3 text-xs text-text-muted">EPRA-licensed EPC and O&amp;M contractor.</p>
      </div>
      <p class="text-xs text-text-muted md:text-right">© {year} Precifarm AI Ltd.<br />Headquartered in Nairobi.</p>
    </div>
  </div>
</footer>
