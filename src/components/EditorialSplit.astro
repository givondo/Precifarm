---
// Editorial split: image on one side, content on the other, alternating
// direction. No card chrome on the image. Replaces the
// card-with-image-on-top pattern used in older sections.

export interface Props {
  image: { src: string; alt: string };
  direction?: 'image-left' | 'image-right';
  imageAspect?: 'square' | 'landscape' | 'tall';
  imageColumns?: 5 | 6 | 7;
}

const {
  image,
  direction = 'image-left',
  imageAspect = 'landscape',
  imageColumns = 6,
} = Astro.props;

const aspectClass = {
  square: 'aspect-square',
  landscape: 'aspect-[4/3]',
  tall: 'aspect-[3/4]',
}[imageAspect];

const imageColClass = { 5: 'lg:col-span-5', 6: 'lg:col-span-6', 7: 'lg:col-span-7' }[imageColumns];
const contentColClass = { 5: 'lg:col-span-7', 6: 'lg:col-span-6', 7: 'lg:col-span-5' }[imageColumns];

const imageOrder = direction === 'image-right' ? 'lg:order-2' : '';
const contentOrder = direction === 'image-right' ? 'lg:order-1' : '';
---
<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
  <div class={`${imageColClass} ${imageOrder}`}>
    <div class="relative overflow-hidden rounded-card">
      <img
        src={image.src}
        alt={image.alt}
        width="1600"
        height="1200"
        loading="lazy"
        decoding="async"
        class={`w-full h-full object-cover ${aspectClass}`}
      />
    </div>
  </div>
  <div class={`${contentColClass} ${contentOrder}`}>
    <slot />
  </div>
</div>
