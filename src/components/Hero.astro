---
export interface Props {
  eyebrow?: string;
  headline: string;
  subhead?: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  badges?: string[];
  variant?: 'default' | 'compact';
}

const {
  eyebrow,
  headline,
  subhead,
  primaryCta,
  secondaryCta,
  badges = [],
  variant = 'default',
} = Astro.props;

const padding = variant === 'compact' ? 'pt-12 pb-10 md:pt-16 md:pb-12' : 'pt-16 pb-12 md:pt-24 md:pb-20';
---
<section class={`bg-paper border-b border-hairline ${padding}`}>
  <div class="container-page">
    <div class="max-w-3xl">
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h1 class="text-h1-sm md:text-display text-navy-dark">{headline}</h1>
      {subhead && (
        <p class="mt-5 text-lg md:text-xl text-text-mid leading-relaxed max-w-prose">
          {subhead}
        </p>
      )}
      {(primaryCta || secondaryCta) && (
        <div class="mt-8 flex flex-wrap gap-3">
          {primaryCta && (
            <a href={primaryCta.href} class="btn btn-primary">{primaryCta.label}</a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn btn-secondary">{secondaryCta.label}</a>
          )}
        </div>
      )}
      {badges.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Key proofs">
          {badges.map((badge) => (
            <li class="badge">
              <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-green"></span>
              {badge}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>
