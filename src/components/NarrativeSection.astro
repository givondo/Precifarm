---
// Open-canvas narrative section. Eyebrow + headline + optional lede,
// followed by a body slot. No card chrome. Used to replace the
// card-grid-inside-section pattern with editorial story flow.
//
// Vertical rhythm: section padding is generous (py-20 md:py-28) for
// breathing room. Background variants align to the alternating
// paper/white/navy-dark rhythm used elsewhere.

export interface Props {
  eyebrow?: string;
  headline: string;
  lede?: string;
  background?: 'white' | 'paper' | 'navy';
  align?: 'left' | 'center';
  maxWidth?: 'prose' | 'wide' | 'full';
  id?: string;
}

const {
  eyebrow,
  headline,
  lede,
  background = 'white',
  align = 'left',
  maxWidth = 'wide',
  id,
} = Astro.props;

const bg = {
  white: 'bg-white',
  paper: 'bg-paper',
  navy: 'bg-navy-dark text-white',
}[background];

const isNavy = background === 'navy';
const headlineColor = isNavy ? 'text-white' : 'text-navy-dark';
const ledeColor = isNavy ? 'text-white/80' : 'text-text-mid';
const eyebrowColor = isNavy ? 'text-amber' : 'text-green';

const alignClass = align === 'center' ? 'text-center mx-auto' : '';
const headWidthClass = {
  prose: 'max-w-2xl',
  wide: 'max-w-3xl',
  full: 'max-w-5xl',
}[maxWidth];
---
<section class={`${bg}`} id={id}>
  <div class="container-page py-20 md:py-28">
    <header class={`${headWidthClass} ${alignClass} mb-12 md:mb-16`}>
      {eyebrow && (
        <p class={`text-xs uppercase tracking-[0.14em] font-semibold ${eyebrowColor} mb-4`}>
          {eyebrow}
        </p>
      )}
      <h2 class={`text-h2-sm md:text-h1 leading-[1.1] ${headlineColor}`}>
        {headline}
      </h2>
      {lede && (
        <p class={`mt-5 text-lg md:text-xl leading-relaxed ${ledeColor}`}>
          {lede}
        </p>
      )}
    </header>
    <div>
      <slot />
    </div>
  </div>
</section>
