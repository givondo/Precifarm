---
export interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}

const { items, heading } = Astro.props;
---
{heading && <h2 class="text-h2-sm md:text-h2 text-navy-dark mb-6">{heading}</h2>}
<div class="space-y-3">
  {items.map((item) => (
    <details class="group rounded-card border border-hairline bg-white open:bg-paper">
      <summary class="cursor-pointer list-none p-5 md:p-6 flex items-start justify-between gap-4">
        <span class="font-semibold text-navy-dark pr-4">{item.q}</span>
        <span
          aria-hidden="true"
          class="mt-1 h-5 w-5 shrink-0 rounded-full border border-hairline flex items-center justify-center transition-transform group-open:rotate-45 bg-white"
        >
          <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none">
            <path d="M6 1.5v9M1.5 6h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
      </summary>
      <div class="px-5 md:px-6 pb-5 md:pb-6 text-text-mid leading-relaxed">
        {item.a}
      </div>
    </details>
  ))}
</div>
