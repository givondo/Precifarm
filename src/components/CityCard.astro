---
import type { City } from '../data/cities';

export interface Props {
  city: City;
}

const { city } = Astro.props;
const href = `/cities/${city.slug}/`;
const isHq = city.role === 'HQ';
---
<a
  href={href}
  class={`group block rounded-card border ${isHq ? 'border-navy bg-callout-green/40' : 'border-hairline bg-white'} p-6 transition-all hover:shadow-md hover:-translate-y-0.5`}
  aria-label={`${city.name} ${city.role.toLowerCase()} details`}
>
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-xs uppercase tracking-wider text-text-muted font-semibold">{city.region} region</p>
      <h3 class="mt-1 text-h3 text-navy-dark">{city.name}</h3>
    </div>
    <span class={`badge text-xs shrink-0 ${isHq ? 'badge-green' : ''}`}>{city.role}</span>
  </div>
  <p class="mt-3 text-sm text-text-mid leading-relaxed">{city.shortNote}</p>
  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-navy group-hover:underline">
    See {city.name} details
    <svg aria-hidden="true" class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none">
      <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</a>
