---
import { packages, getStartingPriceDisplay } from '../data/packages';

type Row = {
  label: string;
  resolve: (pkg: typeof packages[number]) => string;
  emphasis?: boolean;
};

const rows: Row[] = [
  { label: 'Capacity (PV + storage)', resolve: (p) => p.capacity, emphasis: true },
  { label: 'Best for', resolve: (p) => p.bestFor },
  { label: 'Powers', resolve: (p) => p.powers ?? '—' },
  { label: 'Irrigation support', resolve: (p) => p.irrigationSupport ?? p.designedFor ?? '—' },
  { label: 'Daily load', resolve: (p) => p.dailyLoad },
  { label: 'Inverter', resolve: (p) => p.inverter },
  { label: 'Panels', resolve: (p) => p.panels },
  { label: 'Service tier', resolve: (p) => p.serviceTier },
  { label: 'Starting price', resolve: (p) => getStartingPriceDisplay(p), emphasis: true },
];

// Check which packages have an irrigation note so we can render the caveat
// row only when at least one cell will be populated.
const hasAnyIrrigationNote = packages.some((p) => p.irrigationNote);
---
<div class="overflow-x-auto -mx-5 md:mx-0 px-5 md:px-0">
  <table class="w-full min-w-[840px] border-collapse text-sm">
    <caption class="sr-only">Side-by-side comparison of the four Precifarm packages</caption>
    <thead>
      <tr class="border-b-2 border-navy">
        <th scope="col" class="text-left p-4 font-semibold text-text-muted text-xs uppercase tracking-wider align-bottom">Spec</th>
        {packages.map((pkg) => (
          <th scope="col" class={`text-left p-4 align-bottom ${pkg.isHighlighted ? 'bg-callout-amber' : ''}`}>
            <p class="eyebrow text-navy">{pkg.shortName}</p>
            <p class="mt-1 text-h3 text-navy-dark">{pkg.shortName}</p>
            {pkg.isHighlighted && <span class="mt-2 inline-block badge badge-amber text-xs">EV-ready</span>}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row, i) => (
        <tr class={i % 2 === 0 ? 'bg-row-alt' : 'bg-white'}>
          <th scope="row" class="text-left p-4 font-semibold text-text-mid align-top whitespace-nowrap">{row.label}</th>
          {packages.map((pkg) => (
            <td class={`p-4 align-top text-text-mid ${pkg.isHighlighted ? 'bg-callout-amber/50' : ''} ${row.emphasis ? 'text-ink font-semibold' : ''}`}>
              {row.resolve(pkg)}
            </td>
          ))}
        </tr>
      ))}
      {hasAnyIrrigationNote && (
        <tr class="bg-white">
          <th scope="row" class="text-left p-4 font-semibold text-text-mid align-top whitespace-nowrap">Pump caveat</th>
          {packages.map((pkg) => (
            <td class={`p-4 align-top text-xs text-text-muted italic leading-relaxed ${pkg.isHighlighted ? 'bg-callout-amber/50' : ''}`}>
              {pkg.irrigationNote ?? '—'}
            </td>
          ))}
        </tr>
      )}
    </tbody>
    <tfoot>
      <tr class="border-t-2 border-navy">
        <td class="p-4"></td>
        {packages.map((pkg) => (
          <td class={`p-4 ${pkg.isHighlighted ? 'bg-callout-amber' : ''}`}>
            <a href={`/products/${pkg.slug}/`} class="btn btn-secondary text-sm" style="padding: 0.5rem 1rem;">
              {pkg.shortName} details
            </a>
          </td>
        ))}
      </tr>
    </tfoot>
  </table>
</div>
