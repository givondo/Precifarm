---
// Inline metric band: large numerals spread across the page, no card
// chrome. Replaces the 3-card stat strip pattern.

export interface Props {
  metrics: { value: string; label: string; context?: string }[];
  variant?: 'light' | 'navy';
  size?: 'md' | 'lg';
}

const { metrics, variant = 'light', size = 'md' } = Astro.props;
const isNavy = variant === 'navy';

const valueColor = isNavy ? 'text-white' : 'text-navy-dark';
const labelColor = isNavy ? 'text-white/85' : 'text-navy-dark';
const contextColor = isNavy ? 'text-white/60' : 'text-text-muted';
const dividerColor = isNavy ? 'border-white/15' : 'border-hairline';

const valueClass = size === 'lg'
  ? 'text-5xl md:text-6xl lg:text-7xl'
  : 'text-4xl md:text-5xl lg:text-6xl';

const gridColsClass: Record<number, string> = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-3',
  4: 'md:grid-cols-4',
  5: 'md:grid-cols-5',
};
const colsClass = gridColsClass[metrics.length] ?? 'md:grid-cols-3';
---
<div class={`grid grid-cols-1 ${colsClass} gap-y-10 md:gap-x-12 lg:gap-x-16`}>
  {metrics.map((m, i) => (
    <div class={`${i > 0 ? `md:border-l ${dividerColor} md:pl-12 lg:pl-16` : ''}`}>
      <p class={`${valueClass} font-bold tracking-tight leading-none ${valueColor}`}>{m.value}</p>
      <p class={`mt-4 text-base font-semibold ${labelColor}`}>{m.label}</p>
      {m.context && <p class={`mt-2 text-sm leading-relaxed ${contextColor}`}>{m.context}</p>}
    </div>
  ))}
</div>
