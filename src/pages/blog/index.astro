---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTASection from '../../components/CTASection.astro';

// TODO(content): blog posts land as .mdx files in src/content/blog/. The
// index will switch to listing those entries once Astro content collections
// are wired in. For v1, this is an empty index — no posts yet.
const posts: { slug: string; title: string; excerpt: string; date: string }[] = [];
---
<BaseLayout
  title="Blog: notes from the field"
  description="Notes from the field. Engineering write-ups, project debriefs, and operating-discipline thinking from the Precifarm team."
  canonicalPath="/blog/"
>
  <Hero
    eyebrow="Blog"
    headline="Notes from the field."
    subhead="Engineering write-ups, project debriefs, and operating-discipline thinking from the Precifarm team. Coming soon."
  />

  <section class="bg-white">
    <div class="container-page py-20 md:py-28">
      {posts.length === 0 ? (
        <div class="max-w-2xl">
          <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-4">Coming soon</p>
          <h2 class="text-h2-sm md:text-h1 text-navy-dark leading-[1.1] mb-6">No posts yet.</h2>
          <div class="space-y-4 text-lg text-text-mid leading-relaxed">
            <p>
              We are writing the first batch of field notes now. Topics in the pipeline include borehole sizing for Commercial-tier deployments, the Lipa Pole Pole maths from a customer's perspective, and the operating discipline behind the five-year service commitment.
            </p>
          </div>
          <a href="/contact/" class="mt-8 inline-flex btn btn-primary">Talk to us in the meantime</a>
        </div>
      ) : (
        <ul class="space-y-12 max-w-3xl">
          {posts.map((post) => (
            <li class="pb-8 border-b border-hairline last:border-b-0">
              <a href={`/blog/${post.slug}/`} class="group block">
                <p class="text-xs uppercase tracking-wider text-text-muted">{post.date}</p>
                <h2 class="mt-2 text-h2-sm text-navy-dark group-hover:text-navy transition-colors">{post.title}</h2>
                <p class="mt-3 text-text-mid leading-relaxed">{post.excerpt}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <CTASection
    variant="default"
    headline="Want to read something specific?"
    body="If there is a topic you want us to write about, send it over. We are choosing the early posts against what customers actually ask us."
    primaryCta={{ href: '/contact/', label: 'Suggest a topic' }}
  />
</BaseLayout>
