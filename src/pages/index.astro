---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PackageCard from '../components/PackageCard.astro';
import PackageComparisonTable from '../components/PackageComparisonTable.astro';
import Callout from '../components/Callout.astro';
import CTASection from '../components/CTASection.astro';
import StructuredData from '../components/StructuredData.astro';
import { packages } from '../data/packages';
import { exampleInstallations, trustBadges } from '../data/company';
---
<BaseLayout
  title="Reliable solar power for every Kenyan home and business"
  description="Precifarm designs, installs, and services distributed solar and EV-ready charging across Kenya. The same engineering team stays with every system for the five years that follow."
  canonicalPath="/"
>
  <StructuredData slot="head" schema="organization" />
  <StructuredData slot="head" schema="localBusiness" />

  <!-- 01 — Hero -->
  <Hero
    eyebrow="Solar built for Kenya"
    headline="Reliable solar power for every Kenyan home and business."
    subhead="We design, install, and service distributed solar and EV-ready charging across Kenya. The same engineering team stays with your system for the five years that follow."
    primaryCta={{ href: '/products/', label: 'See the packages' }}
    secondaryCta={{ href: '/contact/', label: 'Talk to us' }}
    badges={[...trustBadges]}
    showIllustration={true}
  />

  <!-- 02 — Four packages, one platform -->
  <section class="bg-paper">
    <div class="container-page section">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="eyebrow mb-3">The packages</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">Four packages on one Neura Pod platform.</h2>
        <p class="mt-4 text-lg text-text-mid leading-relaxed">
          Pick the size that fits your loads. The engineering team underneath is identical across all four, from a single-room household to a one-megawatt industrial mini-grid.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
        {packages.map((pkg) => (
          <PackageCard pkg={pkg} />
        ))}
      </div>

      <div class="mt-16 md:mt-20">
        <div class="max-w-3xl mb-8 md:mb-10">
          <p class="eyebrow mb-3">Side-by-side</p>
          <h3 class="text-h2-sm md:text-h2 text-navy-dark">Every spec laid out across the four packages.</h3>
          <p class="mt-3 text-text-mid leading-relaxed">
            Capacity, daily load, inverter, panels, service tier, and starting price for each package, side by side.
          </p>
        </div>
        <PackageComparisonTable />
      </div>

      <div class="mt-12">
        <a href="/products/" class="btn btn-primary">See all package details</a>
      </div>
    </div>
  </section>

  <!-- 03 — How we work, prose-led -->
  <section class="bg-white">
    <div class="container-page section">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">How we work</p>
          <h2 class="text-h2-sm md:text-h1 text-navy-dark mb-6">We stay after the install.</h2>
          <Callout variant="navy" eyebrow="The operating principle" asQuote={true}>
            Critical energy infrastructure demands lifelong accountability.
          </Callout>
        </div>

        <div class="lg:col-span-7 prose-precifarm space-y-5 text-lg">
          <p>
            The crew that designs your system installs it, then returns to service it for the next five years from one of our six city-resident hubs. Engineering, procurement, construction, operations, and maintenance live inside the same team, with no subcontractor handoffs at any stage.
          </p>
          <p>
            That means the engineer who specifies your inverter is the engineer who commissions it on your roof and the engineer who picks up the phone in year three when something needs attention. It is how solar should be built when it is treated as critical infrastructure rather than as a transactional product.
          </p>
          <p>
            <a href="/how-we-work/" class="inline-flex items-center gap-1.5 font-semibold text-navy hover:underline">
              How we deliver EPC and O&amp;M as one obligation
              <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 16 16" fill="none">
                <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 — In the field -->
  <section class="bg-paper">
    <div class="container-page section">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="eyebrow mb-3">In the field</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">These systems are already running across Kenya today.</h2>
        <p class="mt-4 text-lg text-text-mid leading-relaxed">
          A small sample of customer types we design, build, and operate systems for across the country.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {exampleInstallations.map((ex) => (
          <article class="rounded-card border border-hairline bg-white overflow-hidden flex flex-col">
            <div class="relative aspect-[16/10] overflow-hidden bg-paper">
              <img
                src={ex.image}
                alt={ex.alt}
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
              <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-navy-dark/60 via-navy-dark/10 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-4 flex items-baseline justify-between gap-3">
                <p class="text-white font-semibold drop-shadow">{ex.customer}</p>
                <span class="badge badge-amber text-xs shrink-0">{ex.package}</span>
              </div>
            </div>
            <p class="p-5 md:p-6 text-text-mid leading-relaxed flex-1">
              {ex.description}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 — Closing CTA -->
  <CTASection
    variant="dark"
    headline="Reliable solar, supported by a team that answers."
    body="Send us your site. We reply with a written design and a firm quote within two business days of the assessment."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'Compare packages' }}
  />
</BaseLayout>
