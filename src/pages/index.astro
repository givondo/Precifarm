---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PackageCard from '../components/PackageCard.astro';
import PackageComparisonTable from '../components/PackageComparisonTable.astro';
import Callout from '../components/Callout.astro';
import CTASection from '../components/CTASection.astro';
import StructuredData from '../components/StructuredData.astro';
import { packages } from '../data/packages';
import { exampleInstallations, trustBadges } from '../data/company';
---
<BaseLayout
  title="Reliable solar and battery storage that keeps running when the grid does not"
  description="Precifarm builds distributed solar and battery storage infrastructure across Kenya. The Neura Pod is a modular system that upgrades by swap rather than rewire, EV-ready from day one, serviced by the same regional engineering team for five years."
  canonicalPath="/"
>
  <StructuredData slot="head" schema="organization" />
  <StructuredData slot="head" schema="localBusiness" />

  <!-- 01 — Hero -->
  <Hero
    eyebrow="Solar built for Kenya"
    headline="Reliable solar and battery storage that keeps running when the grid does not."
    subhead="Precifarm builds distributed solar and battery storage infrastructure across Kenya. The Neura Pod is a modular system that upgrades by swap rather than rewire, EV-ready from day one, and the same regional engineering team services it across the next five years."
    primaryCta={{ href: '/products/', label: 'See the packages' }}
    secondaryCta={{ href: '/contact/', label: 'Talk to us' }}
    badges={[...trustBadges]}
    showIllustration={true}
  />

  <!-- 02 — Four packages, one platform -->
  <section class="bg-paper">
    <div class="container-page section">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="eyebrow mb-3">The packages</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">Four standardised packages built on a single Neura Pod hardware platform.</h2>
        <p class="mt-4 text-lg text-text-mid leading-relaxed">
          Starter and Family ship at firm cash prices for the standard residential configuration. Commercial and Commercial Plus are sized to the site after a written engineering assessment. The same regional crew designs, installs, and services every system, whatever its scale.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
        {packages.map((pkg) => (
          <PackageCard pkg={pkg} />
        ))}
      </div>

      <div class="mt-16 md:mt-20">
        <div class="max-w-3xl mb-8 md:mb-10">
          <p class="eyebrow mb-3">Side-by-side specification</p>
          <h3 class="text-h2-sm md:text-h2 text-navy-dark">The four packages compared on the specifications that matter.</h3>
          <p class="mt-3 text-text-mid leading-relaxed">
            Capacity, daily load, inverter, panel count, service tier, and starting price for each package, presented side by side so customers and finance partners can map the right tier to the right site in a single read.
          </p>
        </div>
        <PackageComparisonTable />
      </div>

      <div class="mt-12">
        <a href="/products/" class="btn btn-primary">See all package details</a>
      </div>
    </div>
  </section>

  <!-- 03 — How we work, prose-led -->
  <section class="bg-white">
    <div class="container-page section">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">How we work</p>
          <h2 class="text-h2-sm md:text-h1 text-navy-dark mb-6">We stay after the install.</h2>
          <Callout variant="navy" eyebrow="The operating principle" asQuote={true}>
            Critical energy infrastructure demands lifelong accountability.
          </Callout>
        </div>

        <div class="lg:col-span-7 prose-precifarm space-y-5 text-lg">
          <p>
            Precifarm operates as a vertically integrated EPC and O&amp;M contractor. The engineering team that designs your system also procures the hardware, leads the on-site installation, commissions the inverter and storage, and returns through every year of the five-year service commitment that follows. Nothing is subcontracted at any stage, and no contractor walks away once the system is energised.
          </p>
          <p>
            Service capacity is local. Six city-resident hubs (Nairobi headquarters plus Mombasa, Kisumu, Eldoret, Kitui, and Nakuru) each carry a resident engineering team and a regional spare-parts depot. Every installed customer therefore sits within a same-day drive of an engineer who already knows their system, which is what turns a five-year warranty from a marketing promise into an operational commitment.
          </p>
          <p>
            <a href="/how-we-work/" class="inline-flex items-center gap-1.5 font-semibold text-navy hover:underline">
              Read how we deliver EPC and O&amp;M as one obligation
              <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 16 16" fill="none">
                <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 — Portfolio: representative installations -->
  <section class="bg-paper">
    <div class="container-page section">
      <div class="max-w-3xl mb-12 md:mb-16">
        <p class="eyebrow mb-3">Portfolio</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">These systems are already running across Kenya today.</h2>
        <p class="mt-4 text-lg text-text-mid leading-relaxed">
          Three representative installations, one for each of the standardised residential and commercial tiers. Each profile shows the customer context, the hardware configuration commissioned on site, and the load that the system was sized to carry through both grid and off-grid conditions.
        </p>
      </div>

      <div class="space-y-16 md:space-y-20">
        {exampleInstallations.map((ex, i) => (
          <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            <div class={`lg:col-span-7 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
              <div class="relative overflow-hidden rounded-card shadow-lg ring-1 ring-black/5">
                <img
                  src={ex.image}
                  alt={ex.alt}
                  width="1600"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover aspect-[16/10]"
                />
              </div>
            </div>
            <div class={`lg:col-span-5 ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
              <div class="flex items-center gap-3 mb-4">
                <span class="badge badge-amber text-xs">{ex.package} package</span>
                <span class="text-xs uppercase tracking-wider font-semibold text-text-muted">Customer-type illustration</span>
              </div>
              <h3 class="text-h2-sm md:text-h2 text-navy-dark mb-4">{ex.customer}.</h3>
              <p class="text-text-mid leading-relaxed mb-6">{ex.description}</p>

              <dl class="grid grid-cols-1 gap-3 border-t border-hairline pt-5 text-sm">
                <div class="flex flex-col sm:flex-row sm:gap-4">
                  <dt class="text-text-muted text-xs uppercase tracking-wider font-semibold sm:w-32 shrink-0 mt-0.5">Region</dt>
                  <dd class="text-ink font-medium">{ex.region}</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:gap-4">
                  <dt class="text-text-muted text-xs uppercase tracking-wider font-semibold sm:w-32 shrink-0 mt-0.5">Capacity</dt>
                  <dd class="text-ink font-medium">{ex.capacity}</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:gap-4">
                  <dt class="text-text-muted text-xs uppercase tracking-wider font-semibold sm:w-32 shrink-0 mt-0.5">Load profile</dt>
                  <dd class="text-ink font-medium">{ex.loadProfile}</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:gap-4">
                  <dt class="text-text-muted text-xs uppercase tracking-wider font-semibold sm:w-32 shrink-0 mt-0.5">Service</dt>
                  <dd class="text-ink font-medium">Five-year EPC and O&amp;M commitment</dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 — Three-pillar identity block -->
  <section class="bg-white">
    <div class="container-page section">
      <div class="max-w-3xl mb-12 md:mb-16">
        <p class="eyebrow mb-3">What Precifarm is</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark leading-[1.1]">Three principles. One distributed-infrastructure thesis.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-hairline border border-hairline rounded-card overflow-hidden">
        <article class="bg-white p-8 md:p-10">
          <p class="eyebrow text-navy mb-3">01</p>
          <h3 class="text-h3 text-navy-dark mb-4">Modular by design.</h3>
          <p class="text-text-mid leading-relaxed">
            The Neura Pod is a single replaceable unit. Upgrades happen by swapping the Pod, not by rewiring the property.
          </p>
        </article>
        <article class="bg-white p-8 md:p-10">
          <p class="eyebrow text-navy mb-3">02</p>
          <h3 class="text-h3 text-navy-dark mb-4">EV-ready from day one.</h3>
          <p class="text-text-mid leading-relaxed">
            The same Pod that powers a home or SME today can charge a vehicle tomorrow. Distributed storage feeds distributed charging.
          </p>
        </article>
        <article class="bg-white p-8 md:p-10">
          <p class="eyebrow text-navy mb-3">03</p>
          <h3 class="text-h3 text-navy-dark mb-4">Built for Africa's grid.</h3>
          <p class="text-text-mid leading-relaxed">
            Designed for unstable supply, rising electric demand, and decentralising load. Continuous operation through outage cycles, not in spite of them.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- 06 — Closing CTA -->
  <CTASection
    variant="dark"
    headline="Reliable solar power, supported by an engineering team that answers."
    body="Send us a brief about your site and we will return a written engineering design and a firm cash quote within two business days of the assessment, with no commitment to proceed."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'Compare packages' }}
  />
</BaseLayout>
