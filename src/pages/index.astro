---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PackageCard from '../components/PackageCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import CTASection from '../components/CTASection.astro';
import { packages } from '../data/packages';
import {
  audienceSegments,
  deploymentSteps,
  exampleInstallations,
  trustBadges,
} from '../data/company';
---
<BaseLayout
  title="Reliable solar power for every Kenyan home and business"
  description="EPRA-licensed EPC and O&M contractor. Four packages on one platform. Designed, installed, and serviced for five years by the same engineering team."
  canonicalPath="/"
>
  <!-- Block 1: Hero -->
  <Hero
    eyebrow="Solar built for Kenya"
    headline="Reliable solar power for every Kenyan home and business."
    subhead="EPRA-licensed EPC and O&M contractor. Four packages on one platform. Designed, installed, and serviced for five years by the same engineering team."
    primaryCta={{ href: '/products/', label: 'See the packages' }}
    secondaryCta={{ href: '/contact/', label: 'Talk to us' }}
    badges={[...trustBadges]}
  />

  <!-- Block 2: Who we install for -->
  <section class="bg-white border-b border-hairline">
    <div class="container-page py-10 md:py-14">
      <p class="eyebrow text-text-muted mb-4">Who we install for</p>
      <ul class="flex flex-wrap gap-2.5" aria-label="Customer segments we serve">
        {audienceSegments.map((segment) => (
          <li class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-paper border border-hairline text-sm font-medium text-text-mid">
            {segment}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Block 3: Four packages, one platform -->
  <section class="bg-paper">
    <div class="container-page section">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="eyebrow mb-3">Products</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">Four packages. One Neura Pod platform.</h2>
        <p class="mt-4 text-lg text-text-mid leading-relaxed">
          Pick the size that fits. The engineering team underneath is the same.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
        {packages.map((pkg) => (
          <PackageCard pkg={pkg} />
        ))}
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/products/" class="btn btn-primary">Compare the four packages</a>
        <p class="text-sm text-text-muted">Capacity, hardware, price, service tier, side-by-side.</p>
      </div>
    </div>
  </section>

  <!-- Block 4: How we work (operating principle) -->
  <section class="bg-white">
    <div class="container-page section">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="eyebrow mb-3">How we work</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">We stay after the install.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <article class="rounded-card border border-hairline bg-white p-6 md:p-7">
          <div class="flex items-center gap-3 mb-4">
            <span aria-hidden="true" class="h-10 w-10 rounded-full bg-callout-green flex items-center justify-center">
              <svg class="h-5 w-5 text-green" viewBox="0 0 20 20" fill="none">
                <path d="M3 10a7 7 0 1014 0 7 7 0 00-14 0z" stroke="currentColor" stroke-width="1.5"/>
                <path d="M7 10l2 2 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <h3 class="text-h3 text-navy-dark">One team, end to end</h3>
          </div>
          <p class="text-text-mid leading-relaxed">
            The crew that designs your system installs it, then services it for the next five years. No subcontractors, no handoffs.
          </p>
        </article>

        <article class="rounded-card border border-hairline bg-white p-6 md:p-7">
          <div class="flex items-center gap-3 mb-4">
            <span aria-hidden="true" class="h-10 w-10 rounded-full bg-callout-green flex items-center justify-center">
              <svg class="h-5 w-5 text-green" viewBox="0 0 20 20" fill="none">
                <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              </svg>
            </span>
            <h3 class="text-h3 text-navy-dark">EPC and O&amp;M as one obligation</h3>
          </div>
          <p class="text-text-mid leading-relaxed">
            Engineering, procurement, construction, operations, and maintenance live in the same team. Most Kenyan installers sell EPC and walk away from O&amp;M. We do not.
          </p>
        </article>

        <article class="rounded-card border border-hairline bg-white p-6 md:p-7">
          <div class="flex items-center gap-3 mb-4">
            <span aria-hidden="true" class="h-10 w-10 rounded-full bg-callout-green flex items-center justify-center">
              <svg class="h-5 w-5 text-green" viewBox="0 0 20 20" fill="none">
                <path d="M10 2C6 2 4 5 4 8c0 4.5 6 10 6 10s6-5.5 6-10c0-3-2-6-6-6z" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </span>
            <h3 class="text-h3 text-navy-dark">Six cities, regional depots</h3>
          </div>
          <p class="text-text-mid leading-relaxed">
            Resident engineering teams in Nairobi, Mombasa, Kisumu, Eldoret, Kitui, and Nakuru. No customer is more than a same-day drive from an engineer who has worked on their system before.
          </p>
        </article>
      </div>

      <div class="mt-10">
        <a href="/how-we-work/" class="inline-flex items-center gap-1.5 text-navy font-semibold hover:underline">
          How we work
          <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 16 16" fill="none">
            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Block 5: Deployment process -->
  <section class="bg-paper border-y border-hairline">
    <div class="container-page section">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="eyebrow mb-3">Deployment</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">Four steps from quote to commissioning.</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        {deploymentSteps.map((step) => (
          <ProcessStep number={step.number} title={step.title} body={step.body} />
        ))}
      </div>
    </div>
  </section>

  <!-- Block 6: Selected installations -->
  <section class="bg-white">
    <div class="container-page section">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="eyebrow mb-3">Installations</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">Already running, today.</h2>
        <p class="mt-4 text-lg text-text-mid leading-relaxed">
          A small sample of systems we have designed, built, and now operate across the country.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {exampleInstallations.map((ex) => (
          <article class="rounded-card border border-hairline bg-white overflow-hidden flex flex-col">
            <div class="bg-navy-dark p-5 flex items-baseline justify-between">
              <p class="text-white font-semibold">{ex.customer}</p>
              <span class="badge badge-amber text-xs">{ex.package}</span>
            </div>
            <p class="p-5 md:p-6 text-text-mid leading-relaxed flex-1">
              {ex.description}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Block 7: Closing CTA -->
  <CTASection
    variant="dark"
    headline="Reliable solar, supported by a team that answers."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'Compare packages' }}
  />
</BaseLayout>
