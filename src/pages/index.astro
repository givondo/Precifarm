---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PackageCard from '../components/PackageCard.astro';
import CTASection from '../components/CTASection.astro';
import StructuredData from '../components/StructuredData.astro';
import { packages } from '../data/packages';
import { exampleInstallations, trustBadges } from '../data/company';
---
<BaseLayout
  title="Solar that works. For five years. For every Kenyan."
  description="Kenya's first EPRA-licensed EPC and O&M contractor delivering distributed solar and EV-ready charging on a single platform. Four packages, six cities, one engineering team."
  canonicalPath="/"
>
  <StructuredData slot="head" schema="organization" />
  <StructuredData slot="head" schema="localBusiness" />

  <!-- 01 — Hero -->
  <Hero
    eyebrow="Solar built for Kenya"
    headline="Solar that works. For five years. For every Kenyan."
    subhead="Kenya's first EPRA-licensed EPC and O&M contractor, delivering distributed solar and EV-ready charging on a single platform across six operating cities."
    primaryCta={{ href: '/products/', label: 'See the packages' }}
    secondaryCta={{ href: '/contact/', label: 'Talk to us' }}
    badges={[...trustBadges]}
    showIllustration={true}
    size="xl"
  />

  <!-- 02 — Mission moment: the operating principle, full-bleed navy -->
  <section class="bg-navy-dark text-white">
    <div class="container-page py-20 md:py-28">
      <div class="max-w-4xl">
        <p class="text-xs uppercase tracking-[0.18em] font-semibold text-amber mb-8">
          The operating principle
        </p>
        <p class="text-2xl md:text-4xl lg:text-5xl font-bold leading-[1.15] tracking-tight text-white">
          Critical energy infrastructure demands lifelong accountability.
        </p>
        <p class="mt-8 md:mt-10 text-lg md:text-xl text-white/80 leading-relaxed max-w-3xl">
          Most Kenyan solar is sold as a transactional product. We build it as infrastructure. The engineering crew that designs your system installs it, then carries it forward for the next five years from one of our six city-resident hubs. No subcontractors. No handoffs. No contractor who disappears in year three.
        </p>
        <div class="mt-10">
          <a href="/how-we-work/" class="inline-flex items-center gap-2 text-amber hover:text-amber-soft font-semibold transition-colors">
            How we work
            <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 16 16" fill="none">
              <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 — The problem, in three numbers -->
  <section class="bg-white">
    <div class="container-page section">
      <div class="max-w-3xl mb-12 md:mb-16">
        <p class="eyebrow mb-4">The problem</p>
        <h2 class="text-h2-sm md:text-h1 lg:text-display text-navy-dark leading-[1.1]">
          Kenyan solar is sold like a product. It should be built like infrastructure.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-hairline border border-hairline rounded-card overflow-hidden">
        <article class="bg-white p-8 md:p-10">
          <p class="text-6xl md:text-7xl font-bold text-navy-dark leading-none tracking-tight">23%</p>
          <p class="mt-6 text-base font-semibold text-navy-dark">of grid power lost in transmission</p>
          <p class="mt-3 text-sm text-text-mid leading-relaxed">
            Network losses tax every kilowatt-hour. Utility bills do not reflect actual uptime, and grid-only buildings carry the cost twice.
          </p>
        </article>
        <article class="bg-white p-8 md:p-10">
          <p class="text-6xl md:text-7xl font-bold text-navy-dark leading-none tracking-tight">~4 yr</p>
          <p class="mt-6 text-base font-semibold text-navy-dark">until orphaned solar systems fail</p>
          <p class="mt-3 text-sm text-text-mid leading-relaxed">
            Battery degradation, inverter faults, and unaddressed maintenance hit before the second warranty cycle completes.
          </p>
        </article>
        <article class="bg-white p-8 md:p-10">
          <p class="text-6xl md:text-7xl font-bold text-navy-dark leading-none tracking-tight">0</p>
          <p class="mt-6 text-base font-semibold text-navy-dark">service infrastructure from most installers</p>
          <p class="mt-3 text-sm text-text-mid leading-relaxed">
            Companies that sold solar at scale a decade ago are not there in year five. Customers chase contractors who have moved on.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- 04 — Four packages -->
  <section class="bg-paper">
    <div class="container-page section">
      <div class="max-w-3xl mb-12 md:mb-16">
        <p class="eyebrow mb-4">The packages</p>
        <h2 class="text-h2-sm md:text-h1 lg:text-display text-navy-dark leading-[1.1]">Four systems. One Neura Pod platform.</h2>
        <p class="mt-6 text-lg md:text-xl text-text-mid leading-relaxed">
          From a 1.5 kilowatt-hour Starter pack on a single wall to a one-megawatt EV-ready mini-grid serving an industrial tenant. Same engineering team, same five-year service commitment, regardless of scale.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5 md:gap-6">
        {packages.map((pkg) => (
          <PackageCard pkg={pkg} />
        ))}
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/products/" class="btn btn-primary">Compare the four packages</a>
        <p class="text-sm text-text-muted max-w-prose">
          Capacity, hardware, daily load, inverter, panels, service tier, and starting price side by side.
        </p>
      </div>
    </div>
  </section>

  <!-- 05 — How we work — three principles -->
  <section class="bg-white">
    <div class="container-page section">
      <div class="max-w-3xl mb-12 md:mb-16">
        <p class="eyebrow mb-4">How we work</p>
        <h2 class="text-h2-sm md:text-h1 lg:text-display text-navy-dark leading-[1.1]">We stay after the install.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-hairline border border-hairline rounded-card overflow-hidden">
        <article class="bg-white p-8 md:p-10">
          <p class="text-amber font-bold text-sm tracking-wider mb-4">01</p>
          <h3 class="text-h3 text-navy-dark mb-3">One team, end to end</h3>
          <p class="text-text-mid leading-relaxed">
            The crew that designs your system installs it, then services it for the next five years. No subcontractors, no handoffs, no contractor who disappears once the work is done.
          </p>
        </article>
        <article class="bg-white p-8 md:p-10">
          <p class="text-amber font-bold text-sm tracking-wider mb-4">02</p>
          <h3 class="text-h3 text-navy-dark mb-3">EPC and O&amp;M as one obligation</h3>
          <p class="text-text-mid leading-relaxed">
            Engineering, procurement, construction, operations, and maintenance live in the same team. Most Kenyan installers sell EPC and walk away from O&amp;M. We do not split the obligation.
          </p>
        </article>
        <article class="bg-white p-8 md:p-10">
          <p class="text-amber font-bold text-sm tracking-wider mb-4">03</p>
          <h3 class="text-h3 text-navy-dark mb-3">Six cities, regional depots</h3>
          <p class="text-text-mid leading-relaxed">
            Resident engineering teams in Nairobi, Mombasa, Kisumu, Eldoret, Kitui, and Nakuru. No customer is more than a same-day drive from an engineer who has worked on their system before.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- 06 — In the field: customer-type illustrations -->
  <section class="bg-paper">
    <div class="container-page section">
      <div class="max-w-3xl mb-12 md:mb-16">
        <p class="eyebrow mb-4">In the field</p>
        <h2 class="text-h2-sm md:text-h1 lg:text-display text-navy-dark leading-[1.1]">Already running, today.</h2>
        <p class="mt-6 text-lg md:text-xl text-text-mid leading-relaxed">
          A small sample of customer types we design, build, and operate systems for across the country. Each illustrates what a single Precifarm package looks like in daily use.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {exampleInstallations.map((ex) => (
          <article class="rounded-card border border-hairline bg-white overflow-hidden flex flex-col">
            <div class="relative aspect-[16/10] overflow-hidden bg-paper">
              <img
                src={ex.image}
                alt={ex.alt}
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
              <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-navy-dark/60 via-navy-dark/10 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-4 flex items-baseline justify-between gap-3">
                <p class="text-white font-semibold drop-shadow">{ex.customer}</p>
                <span class="badge badge-amber text-xs shrink-0">{ex.package}</span>
              </div>
            </div>
            <p class="p-5 md:p-6 text-text-mid leading-relaxed flex-1">
              {ex.description}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 07 — Closing CTA -->
  <CTASection
    variant="dark"
    headline="Solar that works. Backed by a team that answers."
    body="Send us your site. We reply with a written design and a firm quote within two business days of the assessment. No commitment, no pressure, no subcontractors."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'Compare packages' }}
  />
</BaseLayout>
