  >
    <div class="max-w-4xl">
      <FAQ items={trainingFaqs} />
    </div>
  </NarrativeSection>

  <CTASection
    variant="dark"
    headline="The licence is the floor. Build the competence on top of it."
    body={`Register for a Precifarm T1, T2, or T3 cohort. Or contact us at ${company.email} with any prior questions before you register.`}
    primaryCta={{ href: '#register', label: 'Register interest' }}
    secondaryCta={{ href: '/about/', label: 'About Precifarm' }}
  />

  <script>
    (function () {
      const form = document.querySelector<HTMLFormElement>('form[name="training-registration"]');
      if (!form) return;
      const pathField = form.querySelector<HTMLInputElement>('input[name="page_path"]');
      const tsField = form.querySelector<HTMLInputElement>('input[name="submitted_at"]');
      const phoneField = form.querySelector<HTMLInputElement>('input[name="phone"]');
      const phoneE164Field = form.querySelector<HTMLInputElement>('input[name="phone_e164"]');

      if (pathField) pathField.value = window.location.pathname + window.location.search;

      function normaliseKenyanPhone(raw: string): string {
        const digits = String(raw || '').replace(/\D/g, '');
        let core = digits;
        if (core.startsWith('254')) core = core.slice(3);
        if (core.startsWith('0')) core = core.slice(1);
        return core ? '+254' + core : '';
      }

      form.addEventListener('submit', () => {
        if (tsField) tsField.value = new Date().toISOString();
        if (phoneField && phoneE164Field) {
          phoneE164Field.value = normaliseKenyanPhone(phoneField.value);
        }
      });
    })();
  </script>
</BaseLayout>
