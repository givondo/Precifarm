---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NarrativeSection from '../../components/NarrativeSection.astro';
import CTASection from '../../components/CTASection.astro';
import Callout from '../../components/Callout.astro';
import { cities } from '../../data/cities';
import type { City } from '../../data/cities';

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { slug: city.slug },
    props: { city },
  }));
}

interface Props {
  city: City;
}

const { city } = Astro.props;
const otherCities = cities.filter((c) => c.slug !== city.slug);
const isHq = city.role === 'HQ';
---
<BaseLayout
  title={`Solar contractor in ${city.name}, Kenya`}
  description={`Precifarm ${city.role.toLowerCase()} in ${city.name}, ${city.region} region. Resident engineering team and regional spare-parts depot. All four Neura Pod packages plus solar irrigation systems available.`}
  canonicalPath={`/cities/${city.slug}/`}
  keywords={[`solar installer ${city.name}`, `Neura Pod ${city.name}`, `EPRA-licensed solar ${city.region}`, 'distributed solar Kenya']}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Cities', href: '/cities/' },
    { name: city.name, href: `/cities/${city.slug}/` },
  ]}
>
  <!-- HERO — navy editorial, no card chrome -->
  <section class="bg-navy-dark text-white">
    <div class="container-page py-20 md:py-28 lg:py-32">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.18em] font-semibold text-amber mb-5">{city.region} region · {city.role}</p>
        <h1 class="text-h1-sm md:text-display text-white leading-[1.05]">Precifarm in {city.name}.</h1>
        <p class="mt-6 text-lg sm:text-xl md:text-2xl text-white/90 leading-snug font-medium max-w-xl">
          {city.shortNote}
        </p>
        <div class="mt-10 flex flex-col sm:flex-row flex-wrap gap-3">
          <a href="/contact/" class="btn btn-accent justify-center sm:justify-start">Get a quote</a>
          <a href="/cities/" class="btn btn-secondary border-white text-white hover:bg-white hover:text-navy-dark justify-center sm:justify-start">All six cities</a>
        </div>
      </div>
    </div>
  </section>

  <!-- LOCAL CAPABILITY — two-column open layout -->
  <section class="bg-white">
    <div class="container-page py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-8">
          <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-4">Local capability</p>
          <h2 class="text-h2-sm md:text-h1 text-navy-dark leading-[1.1] mb-6">
            What the {city.name} team handles on the ground.
          </h2>
          <p class="text-lg text-text-mid leading-relaxed">{city.localCapability}</p>
        </div>

        <aside class="lg:col-span-4">
          <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-4">Capabilities</p>
          <ul class="space-y-3">
            {city.capabilities.map((cap) => (
              <li class="flex items-start gap-3 py-2 border-b border-hairline">
                <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber"></span>
                <span class="text-navy-dark font-medium">{cap}</span>
              </li>
            ))}
          </ul>
        </aside>
      </div>

      {isHq && (
        <div class="mt-12">
          <Callout variant="amber" eyebrow="Headquarters">
            <p class="text-text-mid leading-relaxed">
              {city.name} is the Precifarm headquarters. The full engineering team, the operations centre, and the primary spare-parts depot operate from this office. Every Commercial Plus pilot deployment runs from {city.name} before sequencing into the field-hub cities.
            </p>
          </Callout>
        </div>
      )}
    </div>
  </section>

  <!-- CUSTOMER SEGMENTS — clean inline list -->
  <NarrativeSection
    background="paper"
    eyebrow={`Who we install for in ${city.name}`}
    headline="Local customer segments."
  >
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4 max-w-4xl">
      {city.customerSegments.map((segment) => (
        <li class="flex gap-4 items-start py-3 border-b border-hairline">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-green"></span>
          <span class="text-text-mid leading-relaxed">{segment}</span>
        </li>
      ))}
    </ul>
  </NarrativeSection>

  <!-- PACKAGES AVAILABLE — compact text strip not a card grid -->
  <section class="bg-white">
    <div class="container-page py-20 md:py-28">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-4">Packages available</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark leading-[1.1]">All four packages in {city.name}.</h2>
        <p class="mt-5 text-lg text-text-mid leading-relaxed">
          Same engineering team, same operating discipline, same five-year service commitment. The {city.name} hub delivers the full Precifarm scope.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-hairline">
        {[
          { name: 'Starter', spec: '550 W · 1.5 kWh', href: '/products/starter/' },
          { name: 'Family', spec: '2.2 kWp · 5 kWh', href: '/products/family/' },
          { name: 'Commercial', spec: 'From 2.75 kWp · 15 kWh', href: '/products/commercial/' },
          { name: 'Commercial Plus', spec: '50 kWp to 1 MWp', href: '/products/commercial-plus/' },
        ].map((p) => (
          <a href={p.href} class="group block py-6 md:py-0 md:px-6 first:md:pl-0 last:md:pr-0">
            <p class="text-xs uppercase tracking-wider font-semibold text-amber mb-2">{p.name}</p>
            <p class="text-text-mid leading-relaxed">{p.spec}</p>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-navy group-hover:underline">
              Details
              <svg aria-hidden="true" class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none">
                <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- OTHER FIELD HUBS — minimal pill row -->
  <section class="bg-paper">
    <div class="container-page py-16">
      <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-4">Other field hubs</p>
      <h2 class="text-h2-sm md:text-h2 text-navy-dark mb-6">Precifarm operates in five more cities.</h2>
      <div class="flex flex-wrap gap-3">
        {otherCities.map((c) => (
          <a href={`/cities/${c.slug}/`} class={`inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-semibold border transition-colors ${c.role === 'HQ' ? 'border-amber bg-callout-amber text-navy-dark hover:bg-amber' : 'border-hairline bg-white text-navy hover:bg-navy hover:text-white'}`}>
            {c.name}
            {c.role === 'HQ' && <span class="text-xs uppercase tracking-wider opacity-70">·HQ</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    variant="dark"
    headline={`Get in touch with the ${city.name} team.`}
    body="Tell us about the site. We will assign an engineer from the field hub responsible for your region, and you will have a written design within two business days of the assessment."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'See the packages' }}
  />
</BaseLayout>
