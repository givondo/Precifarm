---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import NarrativeSection from '../../components/NarrativeSection.astro';
import KenyaMap from '../../components/KenyaMap.astro';
import MetricBand from '../../components/MetricBand.astro';
import CTASection from '../../components/CTASection.astro';
import { cities } from '../../data/cities';
---
<BaseLayout
  title="Six cities, one engineering team"
  description="Precifarm operates from Nairobi HQ plus field hubs in Mombasa, Kisumu, Eldoret, Kitui, and Nakuru. Resident engineering teams and regional spare-parts depots in every city."
  canonicalPath="/cities/"
>
  <Hero
    eyebrow="Cities"
    headline="One engineering team operating from six city-resident hubs."
    subhead="Headquarters in Nairobi. Resident engineering teams and regional spare-parts depots in Mombasa, Kisumu, Eldoret, Kitui, and Nakuru. Every installed system sits within a same-day drive of an engineer who has worked on it before."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/how-we-work/', label: 'How we work' }}
  />

  <!-- MAP — Kenya outline with 6 markers -->
  <section class="bg-paper">
    <div class="container-page py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-7">
          <KenyaMap />
        </div>
        <div class="lg:col-span-5">
          <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-4">Operating footprint</p>
          <h2 class="text-h2-sm md:text-h1 text-navy-dark leading-[1.1] mb-6">Distributed engineering across the country.</h2>
          <p class="text-lg text-text-mid leading-relaxed mb-8">
            Every Precifarm field hub is a resident engineering team plus a stocked depot. Inverters, panels, Neura Pods, and consumables are held locally. Fault response, scheduled maintenance, and warranty visits dispatch from the same hub that installed the system.
          </p>
          <ul class="space-y-3">
            {cities.map((city) => (
              <li>
                <a href={`/cities/${city.slug}/`} class="group flex items-baseline justify-between gap-4 py-2 border-b border-hairline hover:border-navy transition-colors">
                  <div>
                    <span class="text-navy-dark font-semibold group-hover:text-navy transition-colors">{city.name}</span>
                    {city.role === 'HQ' && <span class="ml-2 text-xs uppercase tracking-wider font-bold text-amber">HQ</span>}
                  </div>
                  <span class="text-sm text-text-muted">{city.region}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- COVERAGE METRICS -->
  <section class="bg-white">
    <div class="container-page py-16 md:py-20">
      <MetricBand
        size="md"
        metrics={[
          { value: '6', label: 'City-resident engineering hubs', context: 'Nairobi headquarters plus five regional field hubs.' },
          { value: '6', label: 'Regional spare-parts depots', context: 'Inverters, panels, Neura Pods, consumables held locally.' },
          { value: 'Same-day', label: 'Drive coverage to every install', context: 'No customer waits for an engineer to travel from Nairobi.' },
        ]}
      />
    </div>
  </section>

  <!-- WHAT EVERY CITY OFFERS — prose, not card grid -->
  <NarrativeSection
    background="paper"
    eyebrow="Standard across every city"
    headline="All four packages are available in every operating city."
    lede="Whether you are sizing a Starter in Kitui or a Commercial Plus mini-grid in an industrial corridor outside Eldoret, the same engineering team, the same Neura Pod platform, and the same five-year service commitment apply."
    maxWidth="wide"
  />

  <CTASection
    variant="dark"
    headline="Tell us where the site is. We will route the right engineer."
    body="Every enquiry is routed to the field hub responsible for your region. The engineer assigned to your site is the one who will service it across the next five years."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'See the packages' }}
  />
</BaseLayout>
