---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import NarrativeSection from '../../components/NarrativeSection.astro';
import EditorialSplit from '../../components/EditorialSplit.astro';
import MetricBand from '../../components/MetricBand.astro';
import ProcessTimeline from '../../components/ProcessTimeline.astro';
import CTASection from '../../components/CTASection.astro';
import { cities } from '../../data/cities';
import { deploymentSteps, company } from '../../data/company';
---
<BaseLayout
  title="How we work: EPC and O&M as one obligation"
  description="EPRA-licensed EPC and O&M discipline applied to every package. The team that designs your system installs it and services it for the next five years."
  canonicalPath="/how-we-work/"
>
  <Hero
    eyebrow="How we work"
    headline="EPC and O&M discipline, applied to every package."
    subhead="EPRA-licensed throughout. Same engineering team across design, installation, and five years of service."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'See the packages' }}
  />

  <!-- PROBLEM FRAMING — large metric band, no card boxes -->
  <NarrativeSection
    background="white"
    eyebrow="The problem"
    headline="Kenyan solar is sold like a product. It should be built like infrastructure."
    lede="Three structural realities define the gap. Each one is the reason the five-year service commitment exists."
  >
    <MetricBand
      size="lg"
      metrics={[
        {
          value: '23%',
          label: 'of grid power lost in transmission',
          context: 'Network losses tax every kilowatt-hour. KPLC bills do not reflect actual uptime, and grid-only buildings carry the cost twice.',
        },
        {
          value: '~4 yr',
          label: 'until orphaned solar systems fail',
          context: 'Battery degradation, inverter faults, and unaddressed maintenance hit before the second warranty cycle completes.',
        },
        {
          value: '0',
          label: 'service infrastructure from most installers',
          context: 'Companies that sold solar at scale a decade ago are not there in year five. Customers chase contractors who have moved on.',
        },
      ]}
    />
  </NarrativeSection>

  <!-- OPERATING PRINCIPLE — full-bleed navy quote moment -->
  <section class="bg-navy-dark text-white">
    <div class="container-page py-24 md:py-32">
      <div class="max-w-4xl">
        <p class="text-xs uppercase tracking-[0.18em] font-semibold text-amber mb-8">The operating principle</p>
        <blockquote class="text-3xl md:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight text-white">
          {company.operatingPrinciple}
        </blockquote>
        <div class="mt-10 max-w-3xl space-y-5 text-lg text-white/80 leading-relaxed">
          <p>
            Distributed solar in Kenya tends to be sold as a one-time transaction. A crew shows up, an array goes onto a roof, and the relationship effectively ends. Twelve months later, when an inverter throws an error or a panel loses output, the customer is left chasing a contractor who has already moved on.
          </p>
          <p>
            That is not how critical electrical infrastructure should work. A solar system is the spine of a building's energy supply for the next decade or two. The right operating frame is lifelong accountability: the team that designed and built the system stays present and answerable for as long as the system runs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- EPRA LICENSING — editorial prose, no card chrome -->
  <NarrativeSection
    background="paper"
    eyebrow="Licensing"
    headline="EPRA-licensed throughout."
    maxWidth="prose"
  >
    <div class="max-w-2xl space-y-5 text-lg text-text-mid leading-relaxed">
      <p>
        The Energy and Petroleum Regulatory Authority (EPRA) governs the design, installation, and operation of solar PV systems in Kenya. EPRA licensing is the regulatory floor for any installer working on grid-tied or off-grid solar at the scales Precifarm builds.
      </p>
      <p>
        Every Precifarm crew that touches your site is EPRA-licensed. Every design we issue is signed off by a licensed engineer. Every commissioning record meets the safety, electrical-installation, mounting, and protection standards EPRA sets. This is the baseline our customers, our insurers, and our partner banks all require, and it is the reason we can hold a five-year service commitment with confidence.
      </p>
    </div>
  </NarrativeSection>

  <!-- EPC + O&M MODEL — side-by-side editorial without card boxes -->
  <NarrativeSection
    background="white"
    eyebrow="The model"
    headline="EPC and O&M, held inside the same team."
    lede="When EPC and O&M sit in different organisations, the customer becomes the integrator. They mediate between the team that designed the system and the team supposed to service it. Subtle design choices get lost in handover. Five years later, that is a fault-response problem the customer is paying to solve."
  >
    <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-hairline max-w-5xl">
      <div class="py-6 md:py-0 md:pr-12">
        <p class="text-xs uppercase tracking-wider text-green font-semibold mb-3">EPC</p>
        <h3 class="text-h2-sm text-navy-dark mb-4 leading-tight">Engineering, procurement, construction.</h3>
        <p class="text-text-mid leading-relaxed">
          We design the system against your measured load. We procure the hardware against the design. We construct on site with our own EPRA-licensed crews. This is the chain most contractors stop at.
        </p>
      </div>
      <div class="py-6 md:py-0 md:pl-12">
        <p class="text-xs uppercase tracking-wider text-amber font-semibold mb-3">O&amp;M</p>
        <h3 class="text-h2-sm text-navy-dark mb-4 leading-tight">Operations and maintenance.</h3>
        <p class="text-text-mid leading-relaxed">
          We service the system across the next five years, with priority response on Commercial and Commercial Plus tiers. The same engineering team carries the system forward. The same regional depot stocks the spares. The same record of your install informs every visit.
        </p>
      </div>
    </div>
  </NarrativeSection>

  <!-- ENGINEER ACCOUNTABILITY — image split + cities pill row -->
  <section class="bg-paper">
    <div class="container-page py-20 md:py-28">
      <EditorialSplit
        image={{
          src: '/images/context/installation-crew.jpg',
          alt: "Two installers in fluorescent safety vests and yellow hard hats mounting a tilted solar panel array on a rooftop, with the wall-mounted hybrid inverter already commissioned on the side of the building below them.",
        }}
        direction="image-left"
        imageColumns={6}
      >
        <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-4">Engineer accountability in practice</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark leading-[1.1] mb-6">Six cities, six resident engineering teams, one operating standard.</h2>
        <p class="text-lg text-text-mid leading-relaxed mb-6">
          Nairobi headquarters plus field hubs in Mombasa, Kisumu, Eldoret, Kitui, and Nakuru. Each hub carries a resident engineering team and a regional spare-parts depot. Every installed system therefore sits within a same-day drive of an engineer who has worked on it before.
        </p>
        <div class="flex flex-wrap gap-2">
          {cities.map((city) => (
            <a href={`/cities/${city.slug}/`} class={`inline-flex items-center px-3.5 py-1.5 rounded-full text-sm font-semibold border transition-colors ${city.role === 'HQ' ? 'border-amber bg-callout-amber text-navy-dark' : 'border-hairline bg-white text-navy hover:bg-navy hover:text-white'}`}>
              {city.name}{city.role === 'HQ' && <span class="ml-1.5 text-xs">·HQ</span>}
            </a>
          ))}
        </div>
      </EditorialSplit>
    </div>
  </section>

  <!-- NO SUBCONTRACTORS — prose only -->
  <NarrativeSection
    background="white"
    eyebrow="No handoffs"
    headline={`What "no subcontractors" actually means.`}
    maxWidth="prose"
  >
    <div class="max-w-2xl space-y-5 text-lg text-text-mid leading-relaxed">
      <p>
        We do not subcontract the install, the wiring, or the service visits. The engineer who scopes your site is on the crew that installs your system. The crew that installs your system is the team that returns for the five-year service cycle.
      </p>
      <p>
        This is not because subcontracting is impossible to manage. It is because for a five-year service commitment to mean anything, the people on the hook for the outcome have to be the people in the design and install record. The accountability stays in one team, not split across three.
      </p>
      <p>
        For Commercial Plus deployments where specialised civil works or grid interconnection requires a regulated partner (utility engagement, structural civils on a 1 MWp ground-mount), those partners work to a Precifarm design and a Precifarm-led commissioning. The accountability never leaves us.
      </p>
    </div>
  </NarrativeSection>

  <!-- PROCESS TIMELINE — replaces 4-card ProcessStep grid -->
  <NarrativeSection
    background="paper"
    eyebrow="From quote to commissioning"
    headline="Four steps, every project."
  >
    <ProcessTimeline steps={deploymentSteps.map(s => ({ number: s.number, title: s.title, body: s.body }))} />
  </NarrativeSection>

  <CTASection
    variant="dark"
    headline="Lifelong accountability, in writing."
    body="Every Precifarm install is backed by a five-year service commitment. Tell us about your site and we will reply with a written design within two business days."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'Compare packages' }}
  />
</BaseLayout>
