---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ContactForm from '../../components/ContactForm.astro';
import NarrativeSection from '../../components/NarrativeSection.astro';
import Callout from '../../components/Callout.astro';
import { company } from '../../data/company';

const whatsappHref = `${company.whatsappLink}?text=${encodeURIComponent(company.whatsappMessage)}`;
---
<BaseLayout
  title="Contact Precifarm: get a solar site assessment"
  description="Get a sized recommendation and a written engineering quote within two business days. Email sales@precifarm.com, call +254 794 702 768, or message us on WhatsApp. Service across six Kenyan cities, HQ in Nairobi."
  canonicalPath="/contact/"
  keywords={['Precifarm contact', 'solar quote Kenya', 'solar site assessment', 'EPRA-licensed solar contractor']}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Contact', href: '/contact/' },
  ]}
>
  <Hero
    eyebrow="Contact"
    headline="Get a quote, or just say hello."
    subhead="A written design and quote within two business days of your site assessment. No commitment, no pressure."
  />

  <!-- DIRECT CONTACT — open canvas, hairline-divided strip, no card boxes -->
  <section class="bg-white">
    <div class="container-page py-16 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-hairline">
        <a href={`mailto:${company.email}`} class="group block py-6 md:py-2 md:px-8 first:md:pl-0">
          <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-3">Email</p>
          <p class="text-navy-dark font-semibold text-xl break-words group-hover:text-navy transition-colors">{company.email}</p>
          <p class="mt-2 text-sm text-text-mid">Reply within one business day.</p>
        </a>
        <a href={`tel:${company.phoneE164}`} class="group block py-6 md:py-2 md:px-8">
          <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-3">Phone</p>
          <p class="text-navy-dark font-semibold text-xl group-hover:text-navy transition-colors">{company.phone}</p>
          <p class="mt-2 text-sm text-text-mid">Mon to Sat, business hours EAT.</p>
        </a>
        <a href={whatsappHref} target="_blank" rel="noopener" class="group block py-6 md:py-2 md:px-8 last:md:pr-0">
          <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-3 inline-flex items-center gap-2">
            <svg aria-hidden="true" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
            </svg>
            WhatsApp
          </p>
          <p class="text-navy-dark font-semibold text-xl group-hover:text-navy transition-colors">Message us</p>
          <p class="mt-2 text-sm text-text-mid">Fastest channel for quick questions.</p>
        </a>
      </div>
      <p class="mt-12 text-sm text-text-muted">
        Anywhere in Kenya. HQ in Nairobi. Resident engineering teams in Mombasa, Kisumu, Eldoret, Kitui, and Nakuru.
      </p>
    </div>
  </section>

  <!-- QUOTE FORM -->
  <NarrativeSection
    background="paper"
    eyebrow="Quote enquiry"
    headline="Tell us about the site."
    lede="Loads, location, current grid situation, anything specific. We will reply with a sized recommendation and a written quote within two business days."
  >
    <div class="max-w-4xl">
      <div id="contact-success" class="hidden" data-form-success>
        <Callout variant="green" eyebrow="Enquiry received">
          <p class="text-navy-dark font-semibold mb-2">Thanks. Your enquiry has been received.</p>
          <p class="text-text-mid">We will be in touch within one business day to acknowledge your enquiry and schedule the site assessment. The engineer covering your region will be your single point of contact through to commissioning.</p>
        </Callout>
      </div>
      <div id="contact-form-wrapper">
        <ContactForm />
      </div>
    </div>
  </NarrativeSection>

  <script is:inline>
    (function () {
      if (!window.location.search.includes('success=true')) return;
      const successEl = document.getElementById('contact-success');
      const formEl = document.getElementById('contact-form-wrapper');
      if (!successEl || !formEl) return;
      successEl.classList.remove('hidden');
      formEl.classList.add('hidden');
      successEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      try {
        const url = new URL(window.location.href);
        url.searchParams.delete('success');
        history.replaceState({}, '', url.toString());
      } catch (e) {}
    })();
  </script>

  <!-- WHAT HAPPENS NEXT — vertical connected timeline (was 4 cards) -->
  <NarrativeSection
    background="white"
    eyebrow="What happens next"
    headline="From enquiry to commissioning, on a fixed cadence."
  >
    <div class="max-w-3xl">
      <ol class="relative space-y-10">
        <div aria-hidden="true" class="absolute top-2 left-5 bottom-2 w-px bg-hairline"></div>
        {[
          { n: 1, t: 'We acknowledge within one business day', b: 'Either by email or phone. Your enquiry is logged against the field hub responsible for your region.' },
          { n: 2, t: 'An engineer is assigned by city', b: 'The engineer from the relevant regional team takes ownership of the project and will be your point of contact through to commissioning.' },
          { n: 3, t: 'A free site assessment is scheduled', b: 'Your assigned engineer visits the site. They map every load, every operating hour, and any structural or grid-connection details that affect design.' },
          { n: 4, t: 'Written design and quote within two business days', b: 'You receive a sized recommendation, a bill of quantities, and a firm quote. From there, decide on payment path and we book the install.' },
        ].map((step) => (
          <li class="relative pl-16">
            <span class="absolute left-0 top-0 z-10 h-10 w-10 rounded-full bg-amber text-navy-dark flex items-center justify-center font-bold">{step.n}</span>
            <h3 class="text-h3 text-navy-dark mb-2">{step.t}</h3>
            <p class="text-text-mid leading-relaxed">{step.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </NarrativeSection>
</BaseLayout>
