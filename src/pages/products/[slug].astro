---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import Callout from '../../components/Callout.astro';
import StructuredData from '../../components/StructuredData.astro';
import { packages, commercialPlusArchetypes } from '../../data/packages';
import type { Package } from '../../data/packages';

export function getStaticPaths() {
  return packages.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg },
  }));
}

interface Props {
  pkg: Package;
}

const { pkg } = Astro.props;
const otherPackages = packages.filter((p) => p.slug !== pkg.slug);
const isCommercialPlus = pkg.slug === 'commercial-plus';
---
<BaseLayout
  title={`${pkg.name}: ${pkg.tagline}`}
  description={`${pkg.name}: ${pkg.capacity}. ${pkg.targetCustomer.split('.')[0]}. Five-year service commitment, same engineering team.`}
  canonicalPath={`/products/${pkg.slug}/`}
>
  <StructuredData slot="head" schema="product" pkg={pkg} />
  <StructuredData slot="head" schema="faqPage" faqs={pkg.faqs} />
  <!-- Block 1: Hero -->
  <section class="bg-paper pt-12 pb-10 md:pt-16 md:pb-14">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <p class="eyebrow mb-4">{pkg.shortName}</p>
          <h1 class="text-h1-sm md:text-display text-navy-dark">{pkg.name}</h1>
          <p class="mt-5 text-lg md:text-xl text-text-mid leading-relaxed">{pkg.tagline}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/contact/" class="btn btn-primary">Get a quote</a>
            <a href="/products/" class="btn btn-secondary">Compare all packages</a>
          </div>
          <ul class="mt-8 flex flex-wrap gap-2">
            <li class="badge"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-green"></span>{pkg.capacity}</li>
            <li class="badge"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-green"></span>{pkg.startingPrice}</li>
          </ul>
        </div>
        <div class="hidden lg:block">
          <div class="relative overflow-hidden rounded-card shadow-xl ring-1 ring-black/5">
            <img
              src={pkg.image.src}
              alt={pkg.image.alt}
              width="1600"
              height="1067"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="w-full h-full object-cover aspect-[4/3]"
            />
            <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-navy-dark/30 to-transparent pointer-events-none"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Block 2: Who it's for + Capacity at a glance -->
  <section class="bg-white">
    <div class="container-page section">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-12">
        <div class="lg:col-span-2">
          <p class="eyebrow mb-3">Who it is for</p>
          <h2 class="text-h2-sm md:text-h2 text-navy-dark mb-5">{pkg.bestFor}.</h2>
          <div class="prose-precifarm">
            <p>{pkg.targetCustomer}</p>
          </div>
          <dl class="mt-6 grid grid-cols-1 gap-3 border-t border-hairline pt-5 text-sm">
            <div class="flex flex-col sm:flex-row sm:gap-4">
              <dt class="text-text-muted text-xs uppercase tracking-wider font-semibold sm:w-28 shrink-0 mt-0.5">Daily load</dt>
              <dd class="text-ink">{pkg.dailyLoad}</dd>
            </div>
            <div class="flex flex-col sm:flex-row sm:gap-4">
              <dt class="text-text-muted text-xs uppercase tracking-wider font-semibold sm:w-28 shrink-0 mt-0.5">Hardware</dt>
              <dd class="text-ink">{pkg.hardware}</dd>
            </div>
          </dl>
        </div>

        <aside class="rounded-card border border-hairline bg-paper p-6 md:p-7 self-start">
          <p class="eyebrow text-text-muted mb-3">At a glance</p>
          <dl class="space-y-4 text-sm">
            <div>
              <dt class="text-text-muted text-xs uppercase tracking-wider font-semibold">Capacity</dt>
              <dd class="mt-1 text-ink font-semibold">{pkg.capacity}</dd>
            </div>
            <div>
              <dt class="text-text-muted text-xs uppercase tracking-wider font-semibold">Inverter</dt>
              <dd class="mt-1 text-ink">{pkg.inverter}</dd>
            </div>
            <div>
              <dt class="text-text-muted text-xs uppercase tracking-wider font-semibold">Panels</dt>
              <dd class="mt-1 text-ink">{pkg.panels}</dd>
            </div>
            <div>
              <dt class="text-text-muted text-xs uppercase tracking-wider font-semibold">Starting price</dt>
              <dd class="mt-1 text-ink font-semibold">{pkg.startingPrice}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- Block 3: What you get -->
  <section class="bg-paper">
    <div class="container-page section">
      <div class="max-w-3xl mb-8 md:mb-10">
        <p class="eyebrow mb-3">What you get</p>
        <h2 class="text-h2-sm md:text-h2 text-navy-dark">What every {pkg.shortName} deployment delivers on site.</h2>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 max-w-4xl">
        {pkg.whatYouGet.map((item) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-1 h-5 w-5 shrink-0 rounded-full bg-callout-green flex items-center justify-center">
              <svg class="h-3 w-3 text-green" viewBox="0 0 12 12" fill="none">
                <path d="M2.5 6.5l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="text-text-mid">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {isCommercialPlus && (
    <!-- Commercial Plus only: deployment archetypes -->
    <section class="bg-white">
      <div class="container-page section">
        <div class="max-w-3xl mb-10 md:mb-12">
          <p class="eyebrow mb-3">Deployment archetypes</p>
          <h2 class="text-h2-sm md:text-h1 text-navy-dark">Five deployment archetypes Precifarm sizes and builds to template.</h2>
          <p class="mt-4 text-lg text-text-mid leading-relaxed">
            Each archetype below is a starting configuration template. The final solar, storage, and charging specification is set during the engineering site assessment, against measured site demand, the customer's charging profile, and the available grid interconnection.
          </p>
        </div>
        <div class="space-y-4">
          {commercialPlusArchetypes.map((arch, i) => (
            <article class="rounded-card border border-hairline bg-paper p-6 md:p-7">
              <div class="flex items-start gap-4">
                <span class="text-navy font-bold text-lg shrink-0 w-8">{String(i + 1).padStart(2, '0')}</span>
                <div class="flex-1">
                  <h3 class="text-h3 text-navy-dark">{arch.title}</h3>
                  <p class="mt-2 text-text-mid leading-relaxed">{arch.description}</p>
                  <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
                    <div class="bg-white rounded-md border border-hairline p-3">
                      <p class="text-text-muted text-xs uppercase tracking-wider font-semibold">Solar</p>
                      <p class="mt-1 text-ink font-medium">{arch.solar}</p>
                    </div>
                    <div class="bg-white rounded-md border border-hairline p-3">
                      <p class="text-text-muted text-xs uppercase tracking-wider font-semibold">Storage</p>
                      <p class="mt-1 text-ink font-medium">{arch.storage}</p>
                    </div>
                    <div class="bg-white rounded-md border border-hairline p-3">
                      <p class="text-text-muted text-xs uppercase tracking-wider font-semibold">Charging</p>
                      <p class="mt-1 text-ink font-medium">{arch.charging}</p>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Block 4: Pricing and financing -->
  <section class={isCommercialPlus ? 'bg-paper' : 'bg-white'}>
    <div class="container-page section">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12">
        <div>
          <p class="eyebrow mb-3">Pricing</p>
          <h2 class="text-h2-sm md:text-h2 text-navy-dark mb-5">{pkg.cashPrice}</h2>
          <p class="text-text-mid leading-relaxed">
            {isCommercialPlus
              ? 'Commercial Plus pricing is bespoke and is finalised in writing after the engineering site assessment. The principal variables are measured site load, charging infrastructure scope, storage sizing, the deployment archetype, and any grid-interconnection or net-metering requirements. Payment is accepted by bank transfer, M-Pesa enterprise, or via the partner-bank facility used for financing.'
              : pkg.slug === 'commercial'
                ? 'Cash, M-Pesa, or bank transfer. Pricing is bespoke after the site survey and depends on your measured load, site conditions, and any borehole integration.'
                : 'Cash, M-Pesa, or bank transfer. Pricing is firm once the site survey confirms hardware and labour.'}
          </p>
        </div>
        <div>
          <p class="eyebrow mb-3">Financing</p>
          <h2 class="text-h2-sm md:text-h2 text-navy-dark mb-5">
            {isCommercialPlus ? 'Partner-bank financing, or a five-year operating lease.' : 'Pay your way.'}
          </h2>
          <p class="text-text-mid leading-relaxed">
            {isCommercialPlus
              ? 'Commercial Plus deployments are typically financed through the partner-bank facilities we work with on solar-PV asset finance (KCB Clean Energy, Stanbic Solar PV, Co-op Bank). For institutional anchor sites (schools, clinics, and agricultural cooperatives), the deployment can also be structured as a five-year operating lease, where Precifarm owns and operates the system for an agreed monthly fee and the customer pays for delivered energy on a tariff basis.'
              : pkg.financing}
          </p>
          <a href="/financing/" class="mt-4 inline-flex items-center gap-1.5 text-navy font-semibold hover:underline">
            See all financing options
            <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 16 16" fill="none">
              <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- What your price covers -->
      <div class="mt-12 md:mt-16">
        <p class="eyebrow mb-3">What your price covers</p>
        <h3 class="text-h3 md:text-h2-sm text-navy-dark mb-6">
          {isCommercialPlus
            ? 'A single integrated contract, not a stack of hardware invoices.'
            : 'More than the box on the wall.'}
        </h3>
        <p class="text-text-mid leading-relaxed max-w-prose mb-8">
          {isCommercialPlus
            ? 'A Commercial Plus quote from Precifarm covers the engineering design, the EPRA-licensed installation, the commissioning records, and the five-year operations and maintenance contract as a single integrated engagement. The customer signs one engineering contract, not five separate purchase orders to a panel supplier, an inverter vendor, a storage vendor, an installation crew, and a maintenance retainer.'
            : `A ${pkg.shortName} quote from a hardware-only installer will look cheaper on paper. It buys you the box. Our price buys you the box plus the team that designed it, installed it, and will service it for the next five years.`}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="rounded-card bg-white border border-hairline p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs uppercase tracking-wider text-text-muted font-semibold">01</span>
              <span class="text-xs uppercase tracking-wider text-text-muted font-semibold">Hardware</span>
            </div>
            <p class="text-navy-dark font-semibold text-sm">Tier-1 panels, hybrid inverter, lithium storage</p>
            <p class="mt-2 text-xs text-text-mid leading-relaxed">Sized to your site. Sourced through our regional supply chain.</p>
          </div>
          <div class="rounded-card bg-white border border-hairline p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs uppercase tracking-wider text-text-muted font-semibold">02</span>
              <span class="text-xs uppercase tracking-wider text-text-muted font-semibold">EPRA-licensed install</span>
            </div>
            <p class="text-navy-dark font-semibold text-sm">Engineering, procurement, construction</p>
            <p class="mt-2 text-xs text-text-mid leading-relaxed">Site survey, written design, bill of quantities, commissioning records.</p>
          </div>
          <div class="rounded-card bg-white border border-hairline p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs uppercase tracking-wider text-text-muted font-semibold">03</span>
              <span class="text-xs uppercase tracking-wider text-text-muted font-semibold">Workmanship warranty</span>
            </div>
            <p class="text-navy-dark font-semibold text-sm">One-year cover on our install</p>
            <p class="mt-2 text-xs text-text-mid leading-relaxed">Any fault arising from how we built it is on us, free of charge.</p>
          </div>
          <div class="rounded-card bg-callout-green border border-green p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs uppercase tracking-wider text-green font-semibold">04</span>
              <span class="text-xs uppercase tracking-wider text-green font-semibold">Five-year service</span>
            </div>
            <p class="text-navy-dark font-semibold text-sm">{pkg.serviceTier} tier across five years</p>
            <p class="mt-2 text-xs text-text-mid leading-relaxed">Scheduled maintenance, fault response, warranty management. Same engineering team.</p>
          </div>
        </div>
        <p class="mt-6 text-sm text-text-muted max-w-prose">
          {isCommercialPlus
            ? 'On industrial-scale deployments, the standard five-year contract extends to ten years on request. For institutional anchor sites, the operating-lease structure converts the full lifecycle into a single monthly fee with no upfront capital outlay.'
            : 'Hardware-only quotes typically come in below ours at the install. Most fail to recover that saving past year four, because there is no service to call when something fails. We price the five years up front so the cost of owning the system is the price you saw.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Block 5: Service tier -->
  <section class={isCommercialPlus ? 'bg-white' : 'bg-paper'}>
    <div class="container-page section">
      <div class="max-w-3xl mb-8 md:mb-10">
        <p class="eyebrow mb-3">Service tier · {pkg.serviceTier}</p>
        <h2 class="text-h2-sm md:text-h2 text-navy-dark">{pkg.serviceCommitment}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="rounded-card bg-white border border-hairline p-5">
          <p class="text-text-muted text-xs uppercase tracking-wider font-semibold mb-2">Workmanship</p>
          <p class="text-navy-dark font-semibold">{pkg.warranty}</p>
        </div>
        <div class="rounded-card bg-white border border-hairline p-5">
          <p class="text-text-muted text-xs uppercase tracking-wider font-semibold mb-2">Service tier</p>
          <p class="text-navy-dark font-semibold">{pkg.serviceTier}</p>
        </div>
        <div class="rounded-card bg-white border border-hairline p-5">
          <p class="text-text-muted text-xs uppercase tracking-wider font-semibold mb-2">Commitment</p>
          <p class="text-navy-dark font-semibold">Five-year service, same team</p>
        </div>
      </div>
      <Callout variant="green" eyebrow="What ‘same team’ means">
        <p class="text-text-mid leading-relaxed">
          The engineering team that designs your {pkg.shortName} system is the same team that installs it and services it across the next five years. Your regional depot retains the install record, so the engineer who shows up has worked on your system before.
        </p>
      </Callout>
    </div>
  </section>

  <!-- Block 6: FAQs -->
  <section class={isCommercialPlus ? 'bg-paper' : 'bg-white'}>
    <div class="container-page section">
      <div class="max-w-3xl mb-8 md:mb-10">
        <p class="eyebrow mb-3">Frequently asked</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">{pkg.shortName} questions, answered.</h2>
      </div>
      <div class="max-w-4xl">
        <FAQ items={pkg.faqs} />
      </div>
    </div>
  </section>

  <!-- Other packages -->
  <section class={isCommercialPlus ? 'bg-white' : 'bg-paper'}>
    <div class="container-page section">
      <div class="max-w-3xl mb-8 md:mb-10">
        <p class="eyebrow mb-3">Other packages</p>
        <h2 class="text-h2-sm md:text-h2 text-navy-dark">Maybe a different size fits better.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {otherPackages.map((p) => (
          <a href={`/products/${p.slug}/`} class="block rounded-card border border-hairline bg-white p-5 hover:shadow-md transition-shadow">
            <p class="eyebrow text-navy mb-1">{p.shortName}</p>
            <p class="text-h3 text-navy-dark mb-2">{p.name}</p>
            <p class="text-sm text-text-mid">{p.tagline}</p>
            <p class="mt-3 text-xs text-text-muted">{p.capacity} · {p.startingPrice}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Block 7: Closing CTA -->
  <CTASection
    variant="dark"
    headline={isCommercialPlus
      ? 'Brief us on the site and we will return a sized Commercial Plus engineering design.'
      : `Ready to size a ${pkg.shortName} for your site?`}
    body={isCommercialPlus
      ? 'An on-site engineering assessment, a written design and bill of quantities within two business days of the assessment, and a financing path through our partner banks or via the operating-lease structure. No commitment required to commission the assessment.'
      : 'A free site assessment, a written design and quote within two business days, and a five-year service commitment from the same engineering team.'}
    primaryCta={{ href: '/contact/', label: isCommercialPlus ? 'Brief an engineer' : 'Get a quote' }}
    secondaryCta={{ href: '/financing/', label: 'See financing' }}
  />
</BaseLayout>
