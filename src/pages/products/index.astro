---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PackageCard from '../../components/PackageCard.astro';
import PackageComparisonTable from '../../components/PackageComparisonTable.astro';
import CTASection from '../../components/CTASection.astro';
import { packages } from '../../data/packages';
---
<BaseLayout
  title="Four packages, one platform"
  description="Compare Precifarm Starter, Family, Commercial, and Commercial Plus. Same engineers, same operating discipline, same five-year service commitment."
  canonicalPath="/products/"
>
  <Hero
    eyebrow="Products"
    headline="Four systems. One platform."
    subhead="Same engineers, same operating discipline, same five-year service commitment. Pick the size that fits."
    badges={[
      'EPRA-licensed installation',
      'Five-year service commitment',
      'Written design before you commit',
      'One-year workmanship warranty',
    ]}
  />

  <section class="bg-white">
    <div class="container-page section">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-7">
        {packages.map((pkg) => (
          <PackageCard pkg={pkg} layout="detailed" />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-paper">
    <div class="container-page section">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="eyebrow mb-3">Side-by-side</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">Compare every spec.</h2>
        <p class="mt-4 text-lg text-text-mid leading-relaxed">
          Capacity, daily load, inverter, panels, service tier, starting price. Everything in one table.
        </p>
      </div>
      <PackageComparisonTable />

      <div class="mt-12 md:mt-16 grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-5xl">
        <div class="rounded-card bg-white border border-hairline p-6">
          <p class="eyebrow text-navy mb-3">How we price</p>
          <h3 class="text-h3 text-navy-dark mb-3">Starting price, then site survey.</h3>
          <p class="text-sm text-text-mid leading-relaxed">
            Starter and Family carry firm starting prices because the standard configuration covers most homes. Commercial and Commercial Plus carry a "from" price and a written, firm quote follows the site survey.
          </p>
        </div>
        <div class="rounded-card bg-white border border-hairline p-6">
          <p class="eyebrow text-navy mb-3">What is included</p>
          <h3 class="text-h3 text-navy-dark mb-3">Hardware, install, five-year service.</h3>
          <p class="text-sm text-text-mid leading-relaxed">
            Every starting price covers tier-1 hardware, EPRA-licensed installation, the one-year workmanship warranty, and the five-year service commitment from the same engineering team.
          </p>
        </div>
        <div class="rounded-card bg-callout-green border border-green p-6">
          <p class="eyebrow text-green mb-3">Compare like for like</p>
          <h3 class="text-h3 text-navy-dark mb-3">Hardware-only quotes look cheaper.</h3>
          <p class="text-sm text-text-mid leading-relaxed">
            A hardware-only quote will typically come in below ours at the install. Most of that saving is the absent five-year service. Ask any installer whether the price they quote includes the engineer that returns in year three.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    variant="default"
    headline="Tell us about the room, the home, or the building."
    body="We will reply with a sized recommendation and a written quote within two business days. No commitment, no pressure."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    badges={['Free site assessment', 'Written design and pricing', 'Two-business-day reply']}
  />
</BaseLayout>
