---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import Callout from '../../components/Callout.astro';
import StructuredData from '../../components/StructuredData.astro';

const financingFaqs = [
  {
    q: 'How does Lipa Pole Pole work in practice?',
    a: 'You pay a KSh 12,500 deposit. The Starter system is installed. You then pay KSh 5,472 per month via M-Pesa for 24 months. At the end of the term, the system is fully yours. Total cost is around KSh 143,800 across the financing term.',
  },
  {
    q: 'Do you take a margin on bank financing?',
    a: 'No. Bank financing for Family, Commercial, and Commercial Plus is arranged directly between you and the partner bank using our written design and quote. The bank pays Precifarm; you repay the bank on the terms you agreed. We do not take a financing margin.',
  },
  {
    q: 'Which banks have you worked with most often?',
    a: 'Equity Bank, KCB (including KCB Clean Energy), Co-op Bank, Stanbic Bank (Stanbic Solar PV), and several SACCOs. We will share the contact at the relevant bank if you ask during the site assessment.',
  },
  {
    q: 'Can I pay cash and skip financing?',
    a: 'Yes. Cash, M-Pesa, or bank transfer are all accepted. Many Family and Commercial customers do this because it avoids interest. We will tell you the exact cash price in the written quote.',
  },
  {
    q: 'What happens if I miss a Lipa Pole Pole payment?',
    a: 'We will contact you. Short missed payments are usually rolled forward without affecting the system. Repeated missed payments are handled per the financing agreement you signed when the system was installed. We do not remotely disable systems; doing so would punish customers for problems they can usually solve with a conversation.',
  },
  {
    q: 'Is there an operating-lease option for institutional customers?',
    a: 'Yes, on Commercial Plus deployments at institutional anchor sites (schools, clinics, agricultural cooperatives). Precifarm owns and operates the system for an agreed monthly fee; you pay only for the energy delivered. Useful where capital is constrained but the load profile is well understood. Discuss this during the site assessment.',
  },
  {
    q: 'Can I upgrade the system later if loads grow?',
    a: 'Yes. The Neura Pod platform is the same across all four packages, so the upgrade path is straightforward. We will price the upgrade against the new design when you are ready.',
  },
];
---
<BaseLayout
  title="Financing — how customers pay for Precifarm"
  description="Lipa Pole Pole for Starter, partner-bank financing for Family, Commercial, and Commercial Plus. Cash and M-Pesa accepted. No financing margin from Precifarm."
  canonicalPath="/financing/"
>
  <StructuredData slot="head" schema="faqPage" faqs={financingFaqs} />
  <Hero
    eyebrow="Financing"
    headline="How customers pay for Precifarm."
    subhead="Lipa Pole Pole for Starter. Partner-bank financing for Family, Commercial, and Commercial Plus. Cash and M-Pesa for any tier."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'See the packages' }}
  />

  <!-- Lipa Pole Pole -->
  <section class="bg-white">
    <div class="container-page section">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-12">
        <div class="lg:col-span-2">
          <p class="eyebrow mb-3">Starter tier</p>
          <h2 class="text-h2-sm md:text-h1 text-navy-dark mb-5">Lipa Pole Pole.</h2>
          <div class="prose-precifarm">
            <p>
              Lipa Pole Pole is the structured monthly-payment plan for the Precifarm Starter package. It is built for households and renters who want immediate independence from blackouts without paying KSh 95,000 in one go.
            </p>
            <p>
              The terms are straightforward. You pay a deposit of KSh 12,500. The Starter system is installed on site. You then pay KSh 5,472 per month over 24 months via M-Pesa. After 24 months, the system is fully yours and the payments stop.
            </p>
            <p>
              No remote shut-off. No hidden fees. If you miss a payment, we call before anything else.
            </p>
          </div>
        </div>

        <aside class="rounded-card bg-callout-amber border border-amber p-6 md:p-7 self-start">
          <p class="eyebrow text-navy-dark mb-3">Lipa Pole Pole terms</p>
          <dl class="space-y-4 text-sm">
            <div>
              <dt class="text-text-mid text-xs uppercase tracking-wider font-semibold">Deposit</dt>
              <dd class="mt-1 text-navy-dark font-semibold text-lg">KSh 12,500</dd>
            </div>
            <div>
              <dt class="text-text-mid text-xs uppercase tracking-wider font-semibold">Monthly</dt>
              <dd class="mt-1 text-navy-dark font-semibold text-lg">KSh 5,472</dd>
            </div>
            <div>
              <dt class="text-text-mid text-xs uppercase tracking-wider font-semibold">Term</dt>
              <dd class="mt-1 text-navy-dark font-semibold text-lg">24 months</dd>
            </div>
            <div>
              <dt class="text-text-mid text-xs uppercase tracking-wider font-semibold">Collection</dt>
              <dd class="mt-1 text-navy-dark font-semibold text-lg">M-Pesa</dd>
            </div>
            <div class="pt-3 border-t border-amber/40">
              <dt class="text-text-mid text-xs uppercase tracking-wider font-semibold">Total over term</dt>
              <dd class="mt-1 text-navy-dark font-semibold text-lg">~ KSh 143,800</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- Bank partner financing -->
  <section class="bg-paper border-y border-hairline">
    <div class="container-page section">
      <div class="max-w-3xl mb-10 md:mb-12">
        <p class="eyebrow mb-3">Family, Commercial, Commercial Plus</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">Bank partner financing.</h2>
        <p class="mt-4 text-lg text-text-mid leading-relaxed">
          Family, Commercial, and Commercial Plus customers typically arrange their financing through a partner bank. Precifarm does not lend and does not take a margin on the loan.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { name: 'Equity Bank', note: 'Family-tier loans, common across all six operating cities.' },
          { name: 'KCB', note: 'General financing across Family and Commercial.' },
          { name: 'Co-op Bank', note: 'SACCO-adjacent financing and cooperative-sector lending.' },
          { name: 'SACCO partners', note: 'Member-based lending common for Family and small Commercial.' },
          { name: 'KCB Clean Energy', note: 'Dedicated clean-energy financing window for Commercial.' },
          { name: 'Stanbic Solar PV', note: 'Stanbic\'s solar-PV financing product, sized for Commercial and Commercial Plus.' },
        ].map((bank) => (
          <article class="rounded-card border border-hairline bg-white p-5">
            <h3 class="text-h3 text-navy-dark">{bank.name}</h3>
            <p class="mt-2 text-sm text-text-mid leading-relaxed">{bank.note}</p>
          </article>
        ))}
      </div>

      <Callout variant="green" eyebrow="How it works">
        <ol class="list-decimal pl-5 space-y-2 text-text-mid leading-relaxed">
          <li>You contact us and we run a site assessment.</li>
          <li>You receive a written design and a firm quote.</li>
          <li>You take the quote to the partner bank of your choice and arrange the loan.</li>
          <li>The bank disburses to Precifarm. We install the system on your schedule.</li>
          <li>You repay the bank on the terms you agreed. Precifarm services the system for the next five years.</li>
        </ol>
      </Callout>
    </div>
  </section>

  <!-- Cash and M-Pesa -->
  <section class="bg-white">
    <div class="container-page section">
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">Other payment options</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark mb-6">Cash, M-Pesa, bank transfer.</h2>
        <div class="prose-precifarm">
          <p>
            Any of the four packages can be paid cash up front. M-Pesa and bank transfer are both accepted, with the same written quote and the same five-year service commitment regardless of payment method.
          </p>
          <p>
            For Commercial and Commercial Plus deployments, customers occasionally combine methods, for instance a 30% cash deposit with the balance from bank financing. We are flexible on structure provided the total is settled before commissioning.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="bg-paper border-y border-hairline">
    <div class="container-page section">
      <div class="max-w-3xl mb-8 md:mb-10">
        <p class="eyebrow mb-3">Financing questions</p>
        <h2 class="text-h2-sm md:text-h1 text-navy-dark">Common questions, direct answers.</h2>
      </div>
      <div class="max-w-4xl">
        <FAQ items={financingFaqs} />
      </div>
    </div>
  </section>

  <CTASection
    variant="dark"
    headline="A quote first. A financing path second."
    body="Send us your site. We reply within two business days with a written design and cash price. From there, you pick the financing path that fits."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'Compare packages' }}
  />
</BaseLayout>
