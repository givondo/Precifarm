---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import NarrativeSection from '../../components/NarrativeSection.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import StructuredData from '../../components/StructuredData.astro';

const financingFaqs = [
  {
    q: 'How does Lipa Pole Pole work in practice?',
    a: 'You pay a KSh 12,500 deposit. The Starter system is installed. You then pay KSh 5,472 per month via M-Pesa for 24 months. At the end of the term, the system is fully yours. Total cost is around KSh 143,800 across the financing term.',
  },
  {
    q: 'Do you take a margin on bank financing?',
    a: 'No. Bank financing for Family, Commercial, and Commercial Plus is arranged directly between you and the partner bank using our written design and quote. The bank pays Precifarm; you repay the bank on the terms you agreed. We do not take a financing margin.',
  },
  {
    q: 'Which banks have you worked with most often?',
    a: 'Equity Bank, KCB (including KCB Clean Energy), Co-op Bank, Stanbic Bank (Stanbic Solar PV), and several SACCOs. We will share the contact at the relevant bank if you ask during the site assessment.',
  },
  {
    q: 'Can I pay cash and skip financing?',
    a: 'Yes. Cash, M-Pesa, or bank transfer are all accepted. Many Family and Commercial customers do this because it avoids interest. We will tell you the exact cash price in the written quote.',
  },
  {
    q: 'What happens if I miss a Lipa Pole Pole payment?',
    a: 'We will contact you. Short missed payments are usually rolled forward without affecting the system. Repeated missed payments are handled per the financing agreement you signed when the system was installed. We do not remotely disable systems; doing so would punish customers for problems they can usually solve with a conversation.',
  },
  {
    q: 'Is there an operating-lease option for institutional customers?',
    a: 'Yes, on Commercial Plus deployments at institutional anchor sites (schools, clinics, agricultural cooperatives). Precifarm owns and operates the system for an agreed monthly fee; you pay only for the energy delivered. Useful where capital is constrained but the load profile is well understood. Discuss this during the site assessment.',
  },
  {
    q: 'Can I upgrade the system later if loads grow?',
    a: 'Yes. The Neura Pod platform is the same across all four packages, so the upgrade path is straightforward. We will price the upgrade against the new design when you are ready.',
  },
];

const banks = [
  { name: 'Equity Bank', segment: 'Family tier, six-city coverage' },
  { name: 'KCB', segment: 'Family and Commercial' },
  { name: 'Co-op Bank', segment: 'SACCO-adjacent and cooperative-sector lending' },
  { name: 'SACCO partners', segment: 'Member-based lending across regions' },
  { name: 'KCB Clean Energy', segment: 'Dedicated clean-energy facility for Commercial' },
  { name: 'Stanbic Solar PV', segment: 'Solar-PV product, Commercial and Commercial Plus' },
];
---
<BaseLayout
  title="Financing: how customers pay for Precifarm"
  description="Lipa Pole Pole for Starter, partner-bank financing for Family, Commercial, and Commercial Plus. Cash and M-Pesa accepted. No financing margin from Precifarm."
  canonicalPath="/financing/"
>
  <StructuredData slot="head" schema="faqPage" faqs={financingFaqs} />

  <Hero
    eyebrow="Financing"
    headline="How customers pay for Precifarm."
    subhead="Lipa Pole Pole for Starter. Partner-bank financing for Family, Commercial, and Commercial Plus. Cash and M-Pesa for any tier."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'See the packages' }}
  />

  <!-- LIPA POLE POLE — editorial split, no card chrome -->
  <section class="bg-white">
    <div class="container-page py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7">
          <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-4">Starter tier · Lipa Pole Pole</p>
          <h2 class="text-h2-sm md:text-h1 text-navy-dark leading-[1.1] mb-6">
            A structured monthly-payment plan, paid in M-Pesa, owned at the end.
          </h2>
          <div class="space-y-5 text-lg text-text-mid leading-relaxed">
            <p>
              Lipa Pole Pole is the structured monthly-payment plan for the Precifarm Starter package. It is built for households and renters who want immediate independence from blackouts without paying KSh 95,000 in one go.
            </p>
            <p>
              The terms are straightforward. You pay a deposit of KSh 12,500. The Starter system is installed on site. You then pay KSh 5,472 per month over 24 months via M-Pesa. After 24 months, the system is fully yours and the payments stop.
            </p>
            <p class="text-navy-dark font-semibold">
              No remote shut-off. No hidden fees. If you miss a payment, we call before anything else.
            </p>
          </div>
        </div>

        <aside class="lg:col-span-5 lg:border-l lg:border-hairline lg:pl-10">
          <p class="text-xs uppercase tracking-[0.14em] font-semibold text-amber mb-6">Lipa Pole Pole terms</p>
          <dl class="space-y-6">
            <div>
              <dt class="text-sm text-text-muted font-semibold">Deposit</dt>
              <dd class="mt-1 text-2xl font-bold text-navy-dark">KSh 12,500</dd>
            </div>
            <div>
              <dt class="text-sm text-text-muted font-semibold">Monthly</dt>
              <dd class="mt-1 text-2xl font-bold text-navy-dark">KSh 5,472</dd>
            </div>
            <div>
              <dt class="text-sm text-text-muted font-semibold">Term</dt>
              <dd class="mt-1 text-2xl font-bold text-navy-dark">24 months</dd>
            </div>
            <div>
              <dt class="text-sm text-text-muted font-semibold">Collection</dt>
              <dd class="mt-1 text-2xl font-bold text-navy-dark">M-Pesa</dd>
            </div>
            <div class="pt-5 border-t border-hairline">
              <dt class="text-sm text-text-muted font-semibold">Total over term</dt>
              <dd class="mt-1 text-2xl font-bold text-amber">~ KSh 143,800</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- PARTNER BANKS — inline list, no boxes -->
  <NarrativeSection
    background="paper"
    eyebrow="Family, Commercial, Commercial Plus"
    headline="Bank partner financing."
    lede="Family, Commercial, and Commercial Plus customers typically arrange their financing through a partner bank. Precifarm does not lend and does not take a margin on the loan."
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-3 max-w-4xl mb-12">
      {banks.map((bank) => (
        <div class="flex items-baseline justify-between gap-6 py-3 border-b border-hairline">
          <span class="text-navy-dark font-semibold">{bank.name}</span>
          <span class="text-sm text-text-mid text-right">{bank.segment}</span>
        </div>
      ))}
    </div>

    <!-- 5-step process timeline for bank financing -->
    <div class="max-w-5xl">
      <p class="text-xs uppercase tracking-[0.14em] font-semibold text-green mb-6">How bank financing works</p>
      <ol class="relative space-y-8">
        <div aria-hidden="true" class="absolute top-2 left-4 bottom-2 w-px bg-hairline"></div>
        {[
          { n: 1, t: 'You contact us', b: 'A site assessment is scheduled and an engineer is assigned by city.' },
          { n: 2, t: 'You receive the written design + quote', b: 'A sized recommendation and a firm cash price, issued within two business days of the assessment.' },
          { n: 3, t: 'You take the quote to the partner bank', b: 'You arrange the loan directly with Equity, KCB, Co-op, KCB Clean Energy, Stanbic Solar PV, or your SACCO. We provide whatever supporting documentation the bank needs.' },
          { n: 4, t: 'The bank disburses to Precifarm', b: 'We install the system on the schedule the bank has approved.' },
          { n: 5, t: 'You repay the bank; we service the system', b: 'For the next five years, the same regional engineering team services the system. Repayment runs through the bank on the terms you agreed.' },
        ].map((step) => (
          <li class="relative pl-12">
            <span class="absolute left-0 top-0 z-10 h-8 w-8 rounded-full bg-amber text-navy-dark flex items-center justify-center font-bold text-sm">{step.n}</span>
            <h3 class="text-h3 text-navy-dark mb-1.5">{step.t}</h3>
            <p class="text-text-mid leading-relaxed">{step.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </NarrativeSection>

  <!-- CASH / M-PESA / BANK TRANSFER -->
  <NarrativeSection
    background="white"
    eyebrow="Other payment options"
    headline="Cash, M-Pesa, or bank transfer."
    maxWidth="prose"
  >
    <div class="max-w-2xl space-y-5 text-lg text-text-mid leading-relaxed">
      <p>
        Any of the four packages can be paid cash up front. M-Pesa and bank transfer are both accepted, with the same written quote and the same five-year service commitment regardless of payment method.
      </p>
      <p>
        For Commercial and Commercial Plus deployments, customers occasionally combine methods, for instance a 30% cash deposit with the balance from bank financing. We are flexible on structure provided the total is settled before commissioning.
      </p>
    </div>
  </NarrativeSection>

  <!-- FAQ -->
  <NarrativeSection
    background="paper"
    eyebrow="Financing questions"
    headline="Common questions, direct answers."
  >
    <div class="max-w-4xl">
      <FAQ items={financingFaqs} />
    </div>
  </NarrativeSection>

  <CTASection
    variant="dark"
    headline="We issue the written quote first, then the financing path follows."
    body="Send us your site. We reply within two business days with a written design and cash price. From there, you pick the financing path that fits."
    primaryCta={{ href: '/contact/', label: 'Get a quote' }}
    secondaryCta={{ href: '/products/', label: 'Compare packages' }}
  />
</BaseLayout>
