---
import { packages, getStartingPriceDisplay, isQuoteOnly } from '../data/packages';
import { company } from '../data/company';

const cards = packages.map((pkg) => ({
  pkg,
  image: (pkg.cardImage ?? pkg.image).src,
  price: getStartingPriceDisplay(pkg),
  quoteOnly: isQuoteOnly(pkg),
}));
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Precifarm Product Catalogue 2026</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #0F2832;
      --text: #2A2F35;
      --muted: #6A7079;
      --hairline: #D6D2C4;
      --paper: #FAFAF7;
      --row-alt: #F7F5EF;
      --amber: #C99800;
    }

    @page { size: A4 landscape; margin: 0; }

    @media print {
      body { background: white; }
      .page { box-shadow: none; }
    }

    @media screen {
      body { background: #d8d8d0; padding: 20px 0; }
      .page {
        width: 297mm; height: 210mm;
        margin: 0 auto;
        background: white;
        box-shadow: 0 4px 30px rgba(0,0,0,0.12);
      }
    }

    * { box-sizing: border-box; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      color: var(--text);
      margin: 0; line-height: 1.4;
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
    }
    .page {
      width: 297mm; height: 210mm;
      padding: 11mm 12mm 9mm;
      display: flex; flex-direction: column;
    }

    /* === Header === */
    .top {
      display: flex; justify-content: space-between; align-items: baseline;
      padding-bottom: 4mm; border-bottom: 1pt solid var(--hairline);
    }
    .brand-mark { font-size: 12pt; font-weight: 800; letter-spacing: -0.02em; color: var(--ink); line-height: 1; }
    .top .meta { font-size: 7pt; text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted); font-weight: 600; }

    .title-block {
      margin-top: 4mm; margin-bottom: 5mm;
      display: flex; justify-content: space-between; align-items: flex-start; gap: 16mm;
    }
    h1 { margin: 0; font-size: 16pt; font-weight: 700; line-height: 1.15; color: var(--ink); letter-spacing: -0.01em; flex-shrink: 0; }
    .lede { margin: 0; font-size: 8.5pt; line-height: 1.4; color: var(--text); max-width: 180mm; }

    /* === Cards row === */
    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 4mm;
    }
    .card {
      display: flex; flex-direction: column;
      border: 1pt solid var(--hairline);
      overflow: hidden;
    }
    .card .img-wrap {
      width: 100%; aspect-ratio: 16 / 10;
      background: var(--paper);
      overflow: hidden;
    }
    .card .img-wrap img {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }
    .card .img-wrap.contain img { object-fit: contain; }
    .card .name-row {
      padding: 3mm 4mm 1mm;
      display: flex; justify-content: space-between; align-items: baseline;
      gap: 3mm;
    }
    .card .name { font-size: 11pt; font-weight: 800; color: var(--ink); letter-spacing: -0.01em; line-height: 1; }
    .card .ev {
      font-size: 6pt; font-weight: 700; color: var(--ink);
      border: 1pt solid var(--ink); padding: 1pt 4pt;
      text-transform: uppercase; letter-spacing: 0.1em;
      white-space: nowrap;
    }
    .card .tagline {
      padding: 0 4mm 3mm;
      font-size: 7.5pt; color: var(--muted); font-style: italic;
      line-height: 1.35;
      border-bottom: 1pt solid var(--hairline);
    }
    .card dl {
      margin: 0; padding: 3mm 4mm;
      display: flex; flex-direction: column; gap: 2mm;
      flex: 1;
    }
    .card dl > div {
      display: flex; flex-direction: column; gap: 0.5mm;
    }
    .card dt {
      font-size: 6pt; text-transform: uppercase; letter-spacing: 0.12em;
      color: var(--muted); font-weight: 700;
    }
    .card dd {
      margin: 0; font-size: 7.5pt; color: var(--text); line-height: 1.35;
    }
    .card dd.bold { color: var(--ink); font-weight: 700; }
    .card .price {
      padding: 3mm 4mm; margin-top: auto;
      background: var(--ink); color: white;
      font-size: 8.5pt; font-weight: 700; line-height: 1.3;
      border-top: 1pt solid var(--ink);
    }
    .card .price .label {
      display: block; font-size: 6pt; text-transform: uppercase;
      letter-spacing: 0.12em; color: var(--amber); margin-bottom: 1mm;
      font-weight: 700;
    }

    /* === Below cards: also-from + contact === */
    .below {
      margin-top: 4mm;
      display: grid; grid-template-columns: 1fr 1fr; gap: 8mm;
      padding-top: 3mm; border-top: 1pt solid var(--hairline);
    }
    .below h3 {
      margin: 0 0 1mm;
      font-size: 7pt; font-weight: 700; color: var(--ink);
      text-transform: uppercase; letter-spacing: 0.12em;
    }
    .below p { margin: 0; font-size: 7pt; line-height: 1.4; color: var(--text); }

    .foot {
      margin-top: auto;
      padding-top: 3mm;
      border-top: 1pt solid var(--hairline);
      display: flex; justify-content: space-between; align-items: baseline;
      font-size: 7pt; color: var(--muted);
    }
    .foot .contact { color: var(--ink); font-weight: 600; }
    .foot .contact a { color: var(--ink); text-decoration: none; margin-right: 6mm; }
    .foot .contact a:last-child { margin-right: 0; }
    .foot .legal { font-size: 6.5pt; }
  </style>
</head>
<body>
<section class="page">
  <!-- Header -->
  <div class="top">
    <div class="brand-mark">PRECIFARM</div>
    <div class="meta">Product Catalogue · 2026</div>
  </div>

  <!-- Title + lede -->
  <div class="title-block">
    <h1>Precifarm product line.</h1>
    <p class="lede">EPRA-licensed solar PV and storage, sized for households, SMEs, schools, and institutional sites across Kenya. Every package includes the same five-year EPC and O&amp;M commitment, delivered by the regional engineering team responsible for your area.</p>
  </div>

  <!-- Cards: 4 packages, left to right -->
  <div class="cards">
    {cards.map(({ pkg, image, price, quoteOnly }) => (
      <article class="card">
        <div class={`img-wrap ${pkg.slug === 'starter' || pkg.slug === 'family' ? 'contain' : ''}`}>
          <img src={image} alt="" />
        </div>
        <div class="name-row">
          <div class="name">{pkg.shortName}</div>
          {pkg.isHighlighted && <div class="ev">EV-ready</div>}
        </div>
        <p class="tagline">{pkg.tagline}</p>
        <dl>
          <div>
            <dt>Capacity</dt>
            <dd class="bold">{pkg.capacity}</dd>
          </div>
          <div>
            <dt>Best for</dt>
            <dd>{pkg.bestFor}</dd>
          </div>
          <div>
            <dt>System</dt>
            <dd>{pkg.panels} · {pkg.inverter}</dd>
          </div>
          {pkg.serviceTier && (
            <div>
              <dt>Service tier</dt>
              <dd>{pkg.serviceTier}</dd>
            </div>
          )}
        </dl>
        <div class="price">
          <span class="label">{quoteOnly ? 'Pricing' : 'Starting'}</span>
          {price}
        </div>
      </article>
    ))}
  </div>

  <!-- Sub-product + Training notes -->
  <div class="below">
    <div>
      <h3>Also: Solar Irrigation Systems</h3>
      <p>Submersible borehole pumps, surface pumps, and solar pump controllers. Sized from 1-acre smallholder to 100+ acre commercial farms on a site-assessment basis.</p>
    </div>
    <div>
      <h3>Also: EPRA T1 / T2 / T3 Training</h3>
      <p>Practitioner-led short-cohort programmes that prepare technicians and engineers for the EPRA solar PV licence application. Mapped to the NITA competency framework.</p>
    </div>
  </div>

  <!-- Footer -->
  <div class="foot">
    <div class="contact">
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={`tel:${company.phoneE164}`}>{company.phone}</a>
      <a href={company.website}>precifarm.com</a>
    </div>
    <div class="legal">Precifarm AI Ltd · Nairobi HQ · Mombasa · Kisumu · Eldoret · Nakuru · Nyeri</div>
  </div>
</section>
</body>
</html>
