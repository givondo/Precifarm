---
import { packages, getStartingPriceDisplay } from '../data/packages';
import { company } from '../data/company';

type Row = {
  label: string;
  resolve: (pkg: typeof packages[number]) => string;
  emphasis?: boolean;
};

const rows: Row[] = [
  { label: 'Capacity (PV + storage)', resolve: (p) => p.capacity, emphasis: true },
  { label: 'Best for', resolve: (p) => p.bestFor },
  { label: 'Powers', resolve: (p) => p.powers ?? '—' },
  { label: 'Irrigation support', resolve: (p) => p.irrigationSupport ?? p.designedFor ?? '—' },
  { label: 'Daily load', resolve: (p) => p.dailyLoad },
  { label: 'Inverter', resolve: (p) => p.inverter },
  { label: 'Panels', resolve: (p) => p.panels },
  { label: 'Service tier', resolve: (p) => p.serviceTier },
  { label: 'Starting price', resolve: (p) => getStartingPriceDisplay(p), emphasis: true },
];

const hasAnyIrrigationNote = packages.some((p) => p.irrigationNote);
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Precifarm Product Catalogue 2026</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #0F2832;
      --text: #2A2F35;
      --muted: #6A7079;
      --hairline: #D6D2C4;
      --row-alt: #F7F5EF;
      --paper: #FFFFFF;
    }

    @page { size: A4 landscape; margin: 0; }

    @media print {
      body { background: white; }
      .page { box-shadow: none; }
    }

    @media screen {
      body { background: #d8d8d0; padding: 20px 0; }
      .page {
        width: 297mm; height: 210mm;
        margin: 0 auto;
        background: white;
        box-shadow: 0 4px 30px rgba(0,0,0,0.12);
      }
    }

    * { box-sizing: border-box; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      color: var(--text);
      margin: 0;
      line-height: 1.35;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .page {
      width: 297mm; height: 210mm;
      padding: 12mm 14mm 10mm;
      display: flex; flex-direction: column;
    }

    /* === Top brand row === */
    .top {
      display: flex; justify-content: space-between; align-items: baseline;
      padding-bottom: 4mm;
      border-bottom: 1pt solid var(--hairline);
    }
    .brand-mark {
      font-size: 12pt; font-weight: 800; letter-spacing: -0.02em;
      color: var(--ink); line-height: 1;
    }
    .top .meta {
      font-size: 7pt; text-transform: uppercase; letter-spacing: 0.16em;
      color: var(--muted); font-weight: 600;
    }

    /* === Title === */
    .title-block {
      margin-top: 4mm;
      margin-bottom: 4mm;
      display: flex; justify-content: space-between; align-items: flex-start;
      gap: 16mm;
    }
    h1 {
      margin: 0;
      font-size: 16pt; font-weight: 700; line-height: 1.15;
      color: var(--ink); letter-spacing: -0.01em;
      flex-shrink: 0;
    }
    .lede {
      margin: 0;
      font-size: 8.5pt; line-height: 1.4;
      color: var(--text); max-width: 180mm;
    }

    /* === Table === */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 6.8pt;
      table-layout: fixed;
    }
    table thead th {
      text-align: left;
      padding: 2.5mm 2mm;
      vertical-align: bottom;
      border-bottom: 1.5pt solid var(--ink);
      font-weight: 700;
      color: var(--ink);
      font-size: 9pt;
    }
    table thead th.spec {
      font-size: 6pt; text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--muted); font-weight: 600;
      width: 28mm;
    }
    table thead th .ev-mark {
      display: block;
      margin-top: 0.8mm;
      font-size: 6pt; text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--muted); font-weight: 600;
    }
    table tbody th.row-label {
      text-align: left;
      padding: 2.2mm 2mm;
      vertical-align: top;
      font-weight: 600;
      color: var(--ink);
      font-size: 7pt;
      border-bottom: 1pt solid var(--hairline);
      width: 28mm;
    }
    table tbody td {
      padding: 2.2mm 2mm;
      vertical-align: top;
      font-size: 6.8pt;
      color: var(--text);
      border-bottom: 1pt solid var(--hairline);
      line-height: 1.35;
    }
    table tbody tr.alt th.row-label,
    table tbody tr.alt td {
      background: var(--row-alt);
    }
    table tbody td.emphasis {
      font-weight: 700;
      color: var(--ink);
    }
    table tbody tr.caveat td {
      font-style: italic;
      font-size: 6.2pt;
      color: var(--muted);
    }
    table tfoot td {
      padding: 3mm 2.5mm 0;
      border-top: 1.5pt solid var(--ink);
      font-size: 7.5pt;
    }
    /* Subtle column marker for the EV-ready (highlighted) tier */
    .col-mark th, .col-mark td {
      box-shadow: inset 2pt 0 0 var(--ink), inset -2pt 0 0 var(--ink);
    }

    /* === Below-table notes === */
    .notes {
      margin-top: 4mm;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8mm;
    }
    .note h3 {
      margin: 0 0 1mm;
      font-size: 7pt; font-weight: 700; color: var(--ink);
      text-transform: uppercase; letter-spacing: 0.1em;
    }
    .note p {
      margin: 0;
      font-size: 7pt; line-height: 1.4; color: var(--text);
    }

    /* === Footer === */
    .foot {
      margin-top: auto;
      padding-top: 3mm;
      border-top: 1pt solid var(--hairline);
      display: flex; justify-content: space-between; align-items: baseline;
      font-size: 7pt; color: var(--muted);
    }
    .foot .contact {
      color: var(--ink); font-weight: 600;
    }
    .foot .contact a {
      color: var(--ink); text-decoration: none;
      margin-right: 6mm;
    }
    .foot .contact a:last-child { margin-right: 0; }
    .foot .legal { font-size: 7pt; }
  </style>
</head>
<body>
<section class="page">
  <!-- Top -->
  <div class="top">
    <div class="brand-mark">PRECIFARM</div>
    <div class="meta">Product Catalogue · 2026</div>
  </div>

  <!-- Title -->
  <div class="title-block">
    <h1>Precifarm product line.</h1>
    <p class="lede">EPRA-licensed solar PV and storage, sized for households, SMEs, schools, and institutional sites across Kenya. Every package includes the same five-year EPC and O&amp;M commitment, delivered by the regional engineering team responsible for your area.</p>
  </div>

  <!-- Table (matches the home-page PackageComparisonTable structure) -->
  <table>
    <caption style="position:absolute;left:-9999px;">Side-by-side comparison of the four Precifarm packages</caption>
    <thead>
      <tr>
        <th scope="col" class="spec">Spec</th>
        {packages.map((pkg) => (
          <th scope="col" class={pkg.isHighlighted ? 'highlighted' : ''}>
            {pkg.shortName}
            {pkg.isHighlighted && <span class="ev-mark">EV-ready</span>}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row, i) => (
        <tr class={i % 2 === 0 ? 'alt' : ''}>
          <th scope="row" class="row-label">{row.label}</th>
          {packages.map((pkg) => (
            <td class={row.emphasis ? 'emphasis' : ''}>
              {row.resolve(pkg)}
            </td>
          ))}
        </tr>
      ))}
      {hasAnyIrrigationNote && (
        <tr class="caveat">
          <th scope="row" class="row-label">Pump caveat</th>
          {packages.map((pkg) => (
            <td>{pkg.irrigationNote ?? '—'}</td>
          ))}
        </tr>
      )}
    </tbody>
  </table>

  <!-- Sub-product + Training notes -->
  <div class="notes">
    <div class="note">
      <h3>Also: Solar Irrigation Systems</h3>
      <p>Submersible borehole pumps, surface pumps, and solar pump controllers. Sized from 1-acre smallholder to 100+ acre commercial farms on a site-assessment basis.</p>
    </div>
    <div class="note">
      <h3>Also: EPRA T1 / T2 / T3 Training</h3>
      <p>Practitioner-led short-cohort programmes that prepare technicians and engineers for the EPRA solar PV licence application. Mapped to the NITA competency framework.</p>
    </div>
  </div>

  <!-- Footer -->
  <div class="foot">
    <div class="contact">
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={`tel:${company.phoneE164}`}>{company.phone}</a>
      <a href={company.website}>precifarm.com</a>
    </div>
    <div class="legal">Precifarm AI Ltd · Nairobi HQ · Mombasa · Kisumu · Eldoret · Nakuru · Nyeri</div>
  </div>
</section>
</body>
</html>
