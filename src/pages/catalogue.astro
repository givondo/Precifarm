---
import { packages, getStartingPriceDisplay, isQuoteOnly } from '../data/packages';
import { company } from '../data/company';

const packageMap = Object.fromEntries(packages.map((p) => [p.slug, p]));
const order: Array<{ slug: string; tier: string; profile: string; uses: string; system: string; why: string; financing?: string }> = [
  {
    slug: 'starter',
    tier: 'Starter',
    profile: 'Renters, single-room households, boda riders, kiosks',
    uses: 'Lights, Wi-Fi, TV, phone charging, 1 fan (8–12 hrs/day)',
    system: '550 W solar · 1.5 kWh storage',
    why: 'Independence from blackouts, on a single panel',
    financing: 'or KSh 5,472/mo (Lipa Pole Pole, 24 months)',
  },
  {
    slug: 'family',
    tier: 'Family',
    profile: 'Two-to-three bedroom off-grid homes',
    uses: 'Full-house lighting, fridge, TV, fans, Wi-Fi, small appliances',
    system: '2.2 kWp solar · 5 kWh storage',
    why: 'Zero KPLC bills, full-house comfort',
    financing: 'or partner-bank financing (Equity, KCB, Co-op, SACCO)',
  },
  {
    slug: 'commercial',
    tier: 'Commercial',
    profile: 'Schools, clinics, SMEs, cooperatives',
    uses: 'Classrooms, refrigeration, pumps, full business operations',
    system: 'Sized to site after written assessment',
    why: 'Operational continuity, designed for your loads',
  },
  {
    slug: 'commercial-plus',
    tier: 'Commercial Plus',
    profile: 'Multi-site institutional, industrial, hospitality, EV fleet ops',
    uses: 'Whole-site loads + EV charging, across multiple buildings',
    system: 'Sized to site, EV-ready architecture, BESS-coupled',
    why: 'Coordinated multi-site rollout with anchor-grade service',
  },
];

const rows = order.map((r) => {
  const pkg = packageMap[r.slug];
  return {
    ...r,
    pricing: getStartingPriceDisplay(pkg),
    quoteOnly: isQuoteOnly(pkg),
    highlighted: pkg?.isHighlighted ?? false,
  };
});
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Precifarm Product Catalogue 2026</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --navy: #1F4E5F;
      --navy-dark: #0F2832;
      --amber: #C99800;
      --amber-light: #F4E5B7;
      --green: #1F6F4A;
      --paper: #FAFAF7;
      --row-alt: #F4F1E8;
      --hairline: #D6D2C4;
      --ink: #0F2832;
      --text-mid: #3A4147;
      --text-muted: #5E646B;
    }

    @page { size: A4; margin: 0; }

    @media print {
      body { background: white; }
      .page { box-shadow: none; }
      .screen-only { display: none !important; }
    }

    @media screen {
      body { background: #d8d8d0; padding: 20px 0; }
      .page {
        width: 210mm;
        height: 297mm;
        margin: 0 auto;
        background: white;
        box-shadow: 0 4px 30px rgba(0,0,0,0.15);
      }
    }

    * { box-sizing: border-box; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      color: var(--ink); margin: 0; line-height: 1.4;
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
      font-feature-settings: 'ss01' on, 'cv11' on;
    }
    .page {
      width: 210mm; height: 297mm;
      display: flex; flex-direction: column;
      overflow: hidden;
    }

    /* ==== TOP BRAND BAND ==== */
    .brand-band {
      background: var(--navy-dark);
      color: white;
      padding: 9mm 14mm 8mm;
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 4pt solid var(--amber);
    }
    .brand-mark {
      font-size: 22pt; font-weight: 900; letter-spacing: -0.025em;
      color: white; line-height: 1;
    }
    .brand-mark span { color: var(--amber); }
    .brand-tag {
      text-align: right;
      font-size: 8pt; text-transform: uppercase; letter-spacing: 0.18em;
      font-weight: 700; color: var(--amber);
    }
    .brand-tag .year {
      display: block; font-size: 9pt; color: rgba(255,255,255,0.6);
      margin-top: 2pt; letter-spacing: 0.14em;
    }

    /* ==== HEADLINE ==== */
    .hero {
      padding: 8mm 14mm 6mm;
      background: white;
    }
    .hero h1 {
      margin: 0;
      font-size: 26pt; font-weight: 800; line-height: 1.05;
      letter-spacing: -0.02em; color: var(--navy-dark);
      max-width: 165mm;
    }
    .hero h1 span { color: var(--amber); }
    .hero .sub {
      margin: 3mm 0 0; font-size: 10.5pt; line-height: 1.45;
      color: var(--text-mid); max-width: 170mm;
    }

    /* ==== TRUST STRIP ==== */
    .trust {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 0; padding: 0 14mm; margin: 4mm 0 5mm;
    }
    .trust > div {
      border-left: 3pt solid var(--amber);
      padding: 0 5mm;
    }
    .trust > div:first-child { padding-left: 4mm; }
    .trust .label {
      font-size: 7pt; text-transform: uppercase; letter-spacing: 0.16em;
      font-weight: 700; color: var(--green); margin: 0 0 1mm 0;
    }
    .trust .value {
      font-size: 10pt; font-weight: 700; color: var(--navy-dark);
      margin: 0; line-height: 1.3;
    }

    /* ==== TABLE ==== */
    .table-wrap {
      padding: 0 14mm; flex: 1; display: flex; flex-direction: column;
    }
    .table-eyebrow {
      font-size: 8pt; text-transform: uppercase; letter-spacing: 0.18em;
      font-weight: 700; color: var(--green); margin: 0 0 2mm 0;
    }
    .table-title {
      font-size: 13pt; font-weight: 700; color: var(--navy-dark);
      margin: 0 0 4mm; line-height: 1.2;
    }
    table.cat {
      width: 100%; border-collapse: collapse; font-size: 8.2pt;
      table-layout: fixed;
    }
    table.cat thead th {
      background: var(--navy-dark);
      color: white;
      padding: 4mm 3mm 3mm;
      text-align: left;
      vertical-align: top;
      border-right: 1pt solid rgba(255,255,255,0.1);
      font-weight: 700;
    }
    table.cat thead th:last-child { border-right: none; }
    table.cat thead th.highlight {
      background: var(--amber);
      color: var(--navy-dark);
    }
    table.cat thead th .pkg-name {
      font-size: 11pt; font-weight: 800; line-height: 1; display: block;
      letter-spacing: -0.01em;
    }
    table.cat thead th .pkg-sub {
      font-size: 7pt; text-transform: uppercase; letter-spacing: 0.14em;
      font-weight: 700; margin-top: 2pt; opacity: 0.7; display: block;
    }
    table.cat thead th.highlight .pkg-sub { opacity: 0.9; }
    table.cat thead th.spec-col {
      background: var(--navy);
      width: 22mm;
    }

    table.cat tbody th.row-label {
      background: var(--paper);
      padding: 4mm 3mm; vertical-align: top; text-align: left;
      font-size: 7pt; text-transform: uppercase; letter-spacing: 0.14em;
      font-weight: 700; color: var(--text-muted);
      border-right: 1pt solid var(--hairline);
      border-bottom: 1pt solid var(--hairline);
      width: 22mm;
    }
    table.cat tbody td {
      padding: 4mm 3mm; vertical-align: top;
      border-right: 1pt solid var(--hairline);
      border-bottom: 1pt solid var(--hairline);
      font-size: 8pt; color: var(--text-mid); line-height: 1.4;
    }
    table.cat tbody td:last-child { border-right: none; }
    table.cat tbody tr:nth-child(odd) td { background: white; }
    table.cat tbody tr:nth-child(even) td { background: var(--row-alt); }
    table.cat tbody tr:nth-child(odd) td.highlight { background: rgba(244, 229, 183, 0.45); }
    table.cat tbody tr:nth-child(even) td.highlight { background: rgba(244, 229, 183, 0.85); }
    table.cat tbody tr.pricing-row td {
      font-size: 9pt; font-weight: 700; color: var(--navy-dark); padding-top: 5mm; padding-bottom: 5mm;
    }
    table.cat tbody tr.pricing-row td .financing {
      display: block; font-size: 7pt; font-weight: 500; color: var(--text-muted);
      margin-top: 1mm; line-height: 1.3;
    }
    table.cat tbody tr.pricing-row td.highlight {
      color: var(--navy-dark);
    }
    table.cat tbody tr.why-row {
      background: var(--navy-dark);
    }
    table.cat tbody tr.why-row th.row-label {
      background: var(--navy-dark); color: var(--amber);
      border-bottom: none;
    }
    table.cat tbody tr.why-row td {
      background: var(--navy-dark); color: white;
      font-size: 8.5pt; font-weight: 600; border-bottom: none;
      border-right: 1pt solid rgba(255,255,255,0.1);
    }
    table.cat tbody tr.why-row td:last-child { border-right: none; }
    table.cat tbody tr.why-row td.highlight {
      background: var(--amber); color: var(--navy-dark);
    }

    .ev-badge {
      display: inline-block; background: var(--amber); color: var(--navy-dark);
      font-size: 6pt; font-weight: 800; padding: 1pt 4pt; border-radius: 1pt;
      text-transform: uppercase; letter-spacing: 0.1em; vertical-align: middle;
      margin-left: 3pt;
    }

    /* ==== ALSO FROM PRECIFARM ==== */
    .also {
      margin: 5mm 14mm 0;
      padding: 5mm 6mm;
      background: var(--paper);
      border-left: 4pt solid var(--green);
      display: grid; grid-template-columns: 1fr 1fr; gap: 6mm;
    }
    .also-item .lbl {
      font-size: 7pt; text-transform: uppercase; letter-spacing: 0.16em;
      font-weight: 700; color: var(--green); margin: 0 0 1mm 0;
    }
    .also-item .ttl {
      font-size: 9.5pt; font-weight: 700; color: var(--navy-dark);
      margin: 0 0 1mm 0; line-height: 1.2;
    }
    .also-item .desc {
      font-size: 7.5pt; color: var(--text-mid); margin: 0; line-height: 1.4;
    }

    /* ==== BOTTOM CTA BAND ==== */
    .cta-band {
      margin-top: auto;
      background: var(--amber);
      color: var(--navy-dark);
      padding: 6mm 14mm 5mm;
      display: grid; grid-template-columns: 1.4fr 1fr; gap: 8mm;
      align-items: center;
      border-top: 4pt solid var(--navy-dark);
    }
    .cta-band .pitch {
      font-size: 11pt; font-weight: 700; line-height: 1.25;
      margin: 0; letter-spacing: -0.01em;
    }
    .cta-band .pitch .em {
      display: block; font-size: 8pt; font-weight: 600;
      color: var(--navy); text-transform: uppercase; letter-spacing: 0.12em;
      margin-bottom: 1.5mm;
    }
    .cta-band .channels {
      font-size: 8pt; color: var(--navy-dark); text-align: right;
      line-height: 1.5;
    }
    .cta-band .channels a {
      color: var(--navy-dark); text-decoration: none; font-weight: 700;
    }
    .cta-band .channels strong { display: block; font-size: 9pt; font-weight: 800; }

    /* ==== FOOTER MICROCOPY ==== */
    .micro {
      background: var(--navy-dark);
      color: rgba(255,255,255,0.6);
      padding: 3mm 14mm;
      font-size: 6.5pt; letter-spacing: 0.04em;
      display: flex; justify-content: space-between; align-items: center;
    }
    .micro .brand-mark { font-size: 9pt; color: rgba(255,255,255,0.85); }
    .micro .brand-mark span { color: var(--amber); }
  </style>
</head>
<body>
<section class="page">
  <!-- BRAND BAND -->
  <div class="brand-band">
    <div class="brand-mark">PRECI<span>FARM</span></div>
    <div class="brand-tag">
      Product Catalogue
      <span class="year">2026 · Issue 01</span>
    </div>
  </div>

  <!-- HEADLINE -->
  <div class="hero">
    <h1>Power that <span>doesn't quit</span>, built for the way Kenya actually uses it.</h1>
    <p class="sub">Four standardised solar + storage packages on one modular platform. Designed, installed, and maintained by the same regional engineering team for five years. Pick the tier your loads need, not the tier the brochure pushes.</p>
  </div>

  <!-- TRUST STRIP -->
  <div class="trust">
    <div>
      <p class="label">Licensed</p>
      <p class="value">EPRA EPC + O&amp;M contractor</p>
    </div>
    <div>
      <p class="label">On the ground</p>
      <p class="value">Engineering hubs in six cities</p>
    </div>
    <div>
      <p class="label">Commitment</p>
      <p class="value">Five-year service on every install</p>
    </div>
  </div>

  <!-- TABLE -->
  <div class="table-wrap">
    <p class="table-eyebrow">The line-up</p>
    <p class="table-title">Find your package by who you are and what you run.</p>

    <table class="cat">
      <thead>
        <tr>
          <th class="spec-col"></th>
          {rows.map((r) => (
            <th class={r.highlighted ? 'highlight' : ''}>
              <span class="pkg-name">{r.tier}{r.highlighted && <span class="ev-badge">EV</span>}</span>
              <span class="pkg-sub">{r.tier === 'Commercial Plus' ? 'Anchor-grade' : r.tier === 'Commercial' ? 'Sized to site' : r.tier === 'Family' ? 'Whole-house' : 'Entry'}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        <tr>
          <th class="row-label">If you are</th>
          {rows.map((r) => (
            <td class={r.highlighted ? 'highlight' : ''}>{r.profile}</td>
          ))}
        </tr>
        <tr>
          <th class="row-label">You can run</th>
          {rows.map((r) => (
            <td class={r.highlighted ? 'highlight' : ''}>{r.uses}</td>
          ))}
        </tr>
        <tr>
          <th class="row-label">The system</th>
          {rows.map((r) => (
            <td class={r.highlighted ? 'highlight' : ''}>{r.system}</td>
          ))}
        </tr>
        <tr class="pricing-row">
          <th class="row-label">Investment</th>
          {rows.map((r) => (
            <td class={r.highlighted ? 'highlight' : ''}>
              {r.pricing}
              {r.financing && <span class="financing">{r.financing}</span>}
            </td>
          ))}
        </tr>
        <tr class="why-row">
          <th class="row-label">Why this tier</th>
          {rows.map((r) => (
            <td class={r.highlighted ? 'highlight' : ''}>{r.why}</td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>

  <!-- ALSO FROM PRECIFARM -->
  <div class="also">
    <div class="also-item">
      <p class="lbl">Sub-product</p>
      <p class="ttl">Solar Irrigation Systems</p>
      <p class="desc">Submersible borehole pumps, surface pumps, and solar controllers. Sized from 1-acre smallholder to 100+ acre commercial farms on a site-assessment basis.</p>
    </div>
    <div class="also-item">
      <p class="lbl">Training</p>
      <p class="ttl">EPRA T1, T2, T3 Technician Cohorts</p>
      <p class="desc">Practitioner-led short-cohort programmes that prepare technicians and engineers for the EPRA solar PV licence application. Mapped to the NITA competency framework.</p>
    </div>
  </div>

  <!-- CTA BAND -->
  <div class="cta-band">
    <p class="pitch">
      <span class="em">The next step</span>
      Send us your site. Receive a written design and quote within two business days.
    </p>
    <div class="channels">
      <strong>{company.email}</strong>
      <a href={`tel:${company.phoneE164}`}>{company.phone}</a><br/>
      <a href={company.website}>precifarm.com</a>
    </div>
  </div>

  <!-- MICRO -->
  <div class="micro">
    <div class="brand-mark">PRECI<span>FARM</span></div>
    <div>Precifarm AI Ltd · Nairobi HQ · Mombasa · Kisumu · Eldoret · Nakuru · Nyeri · EPRA-licensed</div>
  </div>
</section>
</body>
</html>
